// ─── Phase 2.5: Dispatch & Assignment ─────────────────────────────────────────

model OrderAssignment {
  id                    String                @id @default(cuid())
  orderId               String
  driverProfileId       String
  assignedByAdminId     String
  status                OrderAssignmentStatus @default(ASSIGNED)
  assignedAt            DateTime
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?
  cancelledByAdminId    String?
  reassignedFromId      String?
  rejectionReason       String?
  cancellationReason    String?
  adminNote             String?
  driverNote            String?
  version               Int                   @default(1)
  offeredAt             DateTime              @default(now())
  expiresAt             DateTime?
  respondedAt           DateTime?
  expiredAt             DateTime?
  revokedAt             DateTime?
  supersededAt          DateTime?
  activeOrderGuard      String?               @unique
  dispatchPolicyVersion String                @default("dispatch-v1")
  eligibilitySnapshot   Json?
  reasonCode            String?
  reasonNote            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  order                         Order                        @relation(fields: [orderId], references: [id])
  driverProfile                 DriverProfile                @relation(fields: [driverProfileId], references: [id])
  assignedByAdmin               User                         @relation("AdminAssignments", fields: [assignedByAdminId], references: [id])
  cancelledByAdmin              User?                        @relation("AdminCancellations", fields: [cancelledByAdminId], references: [id])
  reassignedFrom                OrderAssignment?             @relation("ReassignmentChain", fields: [reassignedFromId], references: [id])
  reassignments                 OrderAssignment[]            @relation("ReassignmentChain")
  events                        OrderAssignmentEvent[]
  operationalEvents             OrderOperationalEvent[]
  deliveryAttempts              DeliveryAttempt[]
  driverOperationCommands       DriverOperationCommand[]
  locationEvidence              DriverLocationEvidence[]
  proofEvidence                 DeliveryProofEvidence[]
  proofOfDelivery               ProofOfDelivery?
  deliveryOtps                  DeliveryOtp[]
  driverEarnings                DriverEarning[]
  dispatchCandidateEvaluationId String?
  dispatchCandidateEvaluation   DispatchCandidateEvaluation? @relation("DispatchCandidateEvaluationAssignments", fields: [dispatchCandidateEvaluationId], references: [id], onDelete: SetNull, map: "OrderAssignment_dispatchCandidateEvaluation_fkey")
  selectedCandidateEvidence     DispatchCandidateEvidence?   @relation("DispatchCandidateEvidenceAssignment")

  /// Immutable per-order evidence for one server-derived dispatch evaluation.
  /// Replays retain the same record; later decisions create a new evaluation.

  @@index([orderId])
  @@index([driverProfileId])
  @@index([status])
  @@index([assignedAt])
  @@index([orderId, status])
  @@index([orderId, status, createdAt])
  @@index([driverProfileId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([driverProfileId, createdAt])
  @@index([dispatchCandidateEvaluationId], map: "OrderAssignment_dispatchCandidateEvaluation_idx")
}

model DispatchCandidateEvaluation {
  id                      String   @id @default(cuid())
  publicReference         String   @unique
  courierOrderId          String
  marketplaceStoreOrderId String?
  deliveryBridgeReference String?
  operationId             String   @unique
  requestHash             String
  policyVersion           String
  pickupRegion            String?
  deliveryRegionId        String?
  requiredCapabilities    Json
  evaluatedAt             DateTime @default(now())
  createdAt               DateTime @default(now())

  courierOrder          Order                       @relation(fields: [courierOrderId], references: [id], onDelete: Restrict, map: "DispatchCandidateEvaluation_order_fkey")
  marketplaceStoreOrder MarketplaceStoreOrder?      @relation(fields: [marketplaceStoreOrderId], references: [id], onDelete: SetNull, map: "DispatchCandidateEvaluation_store_fkey")
  candidates            DispatchCandidateEvidence[]
  assignments           OrderAssignment[]           @relation("DispatchCandidateEvaluationAssignments")

  /// Candidate evidence is immutable except for its terminal disposition and the
  /// assignment selected from it. It contains no contact or location precision.

  @@index([courierOrderId, evaluatedAt], map: "DispatchCandidateEvaluation_order_evaluated_idx")
  @@index([marketplaceStoreOrderId, evaluatedAt], map: "DispatchCandidateEvaluation_store_evaluated_idx")
}

model DispatchCandidateEvidence {
  id                   String    @id @default(cuid())
  publicReference      String    @unique
  evaluationId         String
  driverProfileId      String
  eligible             Boolean
  reasonCodes          Json
  deterministicRank    Int
  distanceEvidenceType String
  distanceMeters       Decimal?  @db.Decimal(12, 2)
  workloadEvidence     Json
  availabilityEvidence Json
  regionMatch          Boolean
  restrictionEvidence  Json
  dataFreshnessAt      DateTime
  disposition          String    @default("PENDING")
  dispositionAt        DateTime?
  selectedAssignmentId String?   @unique(map: "DispatchCandidateEvidence_selected_assignment_key")
  createdAt            DateTime  @default(now())

  evaluation         DispatchCandidateEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, map: "DispatchCandidateEvidence_evaluation_fkey")
  driverProfile      DriverProfile               @relation(fields: [driverProfileId], references: [id], onDelete: Restrict, map: "DispatchCandidateEvidence_driver_fkey")
  selectedAssignment OrderAssignment?            @relation("DispatchCandidateEvidenceAssignment", fields: [selectedAssignmentId], references: [id], onDelete: SetNull, map: "DispatchCandidateEvidence_assignment_fkey")
  Order              Order?                      @relation("DispatchCandidateEvidenceOrder", fields: [orderId], references: [id], onDelete: SetNull, map: "DispatchCandidateEvidence_order_fkey")
  orderId            String?

  @@unique([evaluationId, driverProfileId], map: "DispatchCandidateEvidence_evaluation_driver_key")
  @@index([driverProfileId, createdAt], map: "DispatchCandidateEvidence_driver_created_idx")
  @@index([evaluationId, deterministicRank], map: "DispatchCandidateEvidence_evaluation_rank_idx")
  @@index([disposition, createdAt], map: "DispatchCandidateEvidence_disposition_created_idx")
  @@index([orderId, createdAt], map: "DispatchCandidateEvidence_order_created_idx")
}

