model MarketplaceCart {
  id                   String                   @id @default(cuid())
  publicReference      String                   @unique
  ownerType            MarketplaceCartOwnerType
  customerUserId       String?
  guestTokenHash       String?
  guestTokenVersion    Int                      @default(1)
  serviceAreaReference String?
  status               MarketplaceCartStatus    @default(ACTIVE)
  currency             LedgerCurrency           @default(ZAR)
  version              Int                      @default(1)
  lastActivityAt       DateTime                 @default(now())
  expiresAt            DateTime?
  convertedCheckoutId  String?
  mergedIntoCartId     String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  customer       User?                       @relation("MarketplaceCartCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, map: "MarketplaceCart_customer_fkey")
  mergedIntoCart MarketplaceCart?            @relation("MarketplaceCartMerge", fields: [mergedIntoCartId], references: [id], onDelete: Restrict, map: "MarketplaceCart_mergedInto_fkey")
  mergedCarts    MarketplaceCart[]           @relation("MarketplaceCartMerge")
  storeGroups    MarketplaceCartStoreGroup[]
  lines          MarketplaceCartLine[]
  operations     MarketplaceCartOperation[]
  checkouts      MarketplaceCheckout[]

  @@index([customerUserId, status])
  @@index([guestTokenHash])
  @@index([status, expiresAt])
  @@index([lastActivityAt])
}

model MarketplaceCartStoreGroup {
  id             String                @id @default(cuid())
  cartId         String
  storeId        String
  fulfilmentMode CatalogFulfilmentMode
  customerNote   String?
  version        Int                   @default(1)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  cart  MarketplaceCart       @relation(fields: [cartId], references: [id], onDelete: Restrict, map: "MarketplaceCartStoreGroup_cart_fkey")
  store Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "MarketplaceCartStoreGroup_store_fkey")
  lines MarketplaceCartLine[]

  @@unique([cartId, storeId], map: "MarketplaceCartStoreGroup_cart_store_key")
  @@index([storeId])
}

model MarketplaceCartLine {
  id                         String                       @id @default(cuid())
  publicReference            String                       @unique
  cartId                     String
  storeGroupId               String
  productPublicReference     String
  variantPublicReference     String
  offerPublicReference       String
  quantity                   Int
  observedPublicationVersion String
  observedPriceVersion       String
