generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 27 — notification delivery authority. Relationships to User deliberately
// use stable scalar references: Phase 27 consumes, but never owns, identity/contact.
enum NotificationDeliveryChannel {
  IN_APP
  EMAIL
  SMS
  WEB_PUSH
  ANDROID_PUSH
}

enum NotificationPurpose {
  SECURITY
  LEGAL
  TRANSACTIONAL
  OPERATIONAL
  SERVICE_ANNOUNCEMENT
  MARKETING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationSensitivity {
  PUBLIC
  ACCOUNT
  FINANCIAL
  SECURITY
  RESTRICTED
}

enum NotificationCategoryStatus {
  ACTIVE
  RETIRED
}

enum NotificationTemplateStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum NotificationRouteStatus {
  DRAFT
  APPROVED
  ACTIVE
  RETIRED
}

enum NotificationMessageStatus {
  CREATED
  FANOUT_COMPLETED
  SUPERSEDED
  EXPIRED
}

enum NotificationDeliveryStatus {
  PENDING
  ELIGIBILITY_BLOCKED
  QUEUED
  SENDING
  PROVIDER_ACCEPTED
  DELIVERED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  BOUNCED
  COMPLAINED
  SUPPRESSED
  CANCELLED
  EXPIRED
}

enum NotificationAttemptStatus {
  STARTED
  PROVIDER_ACCEPTED
  FAILED
}

enum NotificationEndpointType {
  WEB_PUSH
  ANDROID_PUSH
}

enum NotificationEndpointStatus {
  ACTIVE
  STALE
  INVALID
  REVOKED
  SUPPRESSED
}

enum NotificationPreferenceMode {
  ENABLED
  DISABLED
  MANDATORY
  CONSENT_REQUIRED
}

enum NotificationDigestMode {
  IMMEDIATE
  DAILY_DIGEST
  DISABLED
}

enum NotificationConsentStatus {
  NOT_REQUESTED
  REQUESTED
  GRANTED
  REVOKED
  EXPIRED
}

enum NotificationSuppressionReason {
  HARD_BOUNCE
  COMPLAINT
  INVALID_PHONE
  SMS_OPT_OUT
  INVALID_PUSH_ENDPOINT
  USER_REVOCATION
  ADMIN_SECURITY_BLOCK
  MARKETING_CONSENT_REVOKED
  REPEATED_PERMANENT_FAILURE
}

enum NotificationReceiptType {
  ACCEPTED
  DELIVERED
  DEFERRED
  BOUNCED
  COMPLAINED
  UNSUBSCRIBED
  FAILED
}

enum NotificationFailureClass {
  TRANSIENT_NETWORK
  PROVIDER_RATE_LIMIT
  PROVIDER_UNAVAILABLE
  INVALID_DESTINATION
  AUTHENTICATION_FAILURE
  CONFIGURATION_FAILURE
  CONTENT_REJECTED
  PERMISSION_DENIED
  CONSENT_REQUIRED
  SUPPRESSED_DESTINATION
  EXPIRED_MESSAGE
  UNKNOWN_PROVIDER_FAILURE
}

enum NotificationReconciliationReason {
  EVENT_ROUTE_NOT_CONFIGURED
  RECIPIENT_NOT_RESOLVED
  UNSAFE_CONTENT
  PROVIDER_CONFIGURATION
  DELIVERY_STALLED
  RECEIPT_MISMATCH
  ENDPOINT_INVALID
}

enum NotificationReconciliationStatus {
  OPEN
  IN_PROGRESS
  CONVERGED
}

model User {
  id                                   String                              @id @default(cuid())
  email                                String                              @unique
  passwordHash                         String?
  name                                 String?
  phone                                String?
  role                                 UserRole
  status                               UserStatus                          @default(PENDING_VERIFICATION)
  emailVerifiedAt                      DateTime?
  lastLoginAt                          DateTime?
  createdAt                            DateTime                            @default(now())
  updatedAt                            DateTime                            @updatedAt
  savedAddresses                       Address[]                           @relation("UserSavedAddresses")
  adminActivityLogs                    AdminActivityLog[]                  @relation("ActorActivityLogs")
  adminProfile                         AdminProfile?
  contactMessages                      ContactMessage[]
  customerProfile                      CustomerProfile?
  driverProfile                        DriverProfile?
  emailLogs                            EmailLog[]                          @relation("UserEmailLogs")
  orders                               Order[]                             @relation("CustomerOrders")
  orderStatusHistory                   OrderStatusHistory[]                @relation("ActorStatusHistory")
  otpCodes                             OtpCode[]
  passwordResetTokens                  PasswordResetToken[]
  sessions                             Session[]
  loginHistory                         LoginHistory[]
  securityEvents                       SecurityEvent[]                     @relation("SecurityEventUser")
  actorSecurityEvents                  SecurityEvent[]                     @relation("SecurityEventActor")
  userPermissionsCreated               UserPermission[]                    @relation("UserPermissionCreatedBy")
  userPermissions                      UserPermission[]                    @relation("UserPermissionUser")
  ownedStores                          Store[]
  storeProfile                         StoreProfile?
  assignmentsCreated                   OrderAssignment[]                   @relation("AdminAssignments")
  assignmentsCancelled                 OrderAssignment[]                   @relation("AdminCancellations")
  operationalEventsActed               OrderOperationalEvent[]             @relation("ActorOperationalEvents")
  proofOfDeliveriesCreated             ProofOfDelivery[]                   @relation("CreatedByUser")
  deliveryOtpsCreated                  DeliveryOtp[]                       @relation("DeliveryOtpCreator")
  payments                             Payment[]
  refundsRequested                     PaymentRefund[]                     @relation("RefundCustomer")
  refundsApproved                      PaymentRefund[]                     @relation("RefundApprovedBy")
  refundsRejected                      PaymentRefund[]                     @relation("RefundRejectedBy")
  refundsCancelled                     PaymentRefund[]                     @relation("RefundCancelledBy")
  refundsCompleted                     PaymentRefund[]                     @relation("RefundCompletedBy")
  refundAttemptsInitiated              RefundExecutionAttempt[]            @relation("RefundAttemptInitiatedBy")
  refundAttemptsCompleted              RefundExecutionAttempt[]            @relation("RefundAttemptCompletedBy")
  refundStatusHistoryActed             RefundStatusHistory[]               @relation("RefundHistoryActor")
  refundReconciliationsResolved        RefundReconciliationCase[]          @relation("RefundReconciliationResolvedBy")
  walletTransactionsCreated            WalletTransaction[]
  ledgerJournalsCreated                LedgerJournal[]                     @relation("LedgerJournalCreatedBy")
  withdrawalsRequested                 WithdrawalRequest[]                 @relation("WithdrawalRequestedBy")
  withdrawalsApproved                  WithdrawalRequest[]                 @relation("WithdrawalApprovedBy")
  withdrawalsRejected                  WithdrawalRequest[]                 @relation("WithdrawalRejectedBy")
  withdrawalsCancelled                 WithdrawalRequest[]                 @relation("WithdrawalCancelledBy")
  withdrawalsCompleted                 WithdrawalRequest[]                 @relation("WithdrawalCompletedBy")
  payoutDestinationsVerified           PayoutDestination[]                 @relation("PayoutDestinationVerifiedBy")
  payoutDestinationsDisabled           PayoutDestination[]                 @relation("PayoutDestinationDisabledBy")
  withdrawalStatusHistory              WithdrawalStatusHistory[]           @relation("WithdrawalHistoryActor")
  payoutAttemptsInitiated              WithdrawalPayoutAttempt[]           @relation("WithdrawalAttemptInitiatedBy")
  payoutAttemptsCompleted              WithdrawalPayoutAttempt[]           @relation("WithdrawalAttemptCompletedBy")
  withdrawalReconciliations            WithdrawalReconciliationCase[]      @relation("WithdrawalReconciliationResolvedBy")
  legacyCommissionRulesCreated         LegacyCommissionRule[]
  commissionPlansCreated               CommissionPlan[]                    @relation("CommissionPlanCreatedBy")
  commissionPlansSubmitted             CommissionPlan[]                    @relation("CommissionPlanSubmittedBy")
  commissionPlansApproved              CommissionPlan[]                    @relation("CommissionPlanApprovedBy")
  commissionPlansRetired               CommissionPlan[]                    @relation("CommissionPlanRetiredBy")
  commissionPlanStatusHistory          CommissionPlanStatusHistory[]       @relation("CommissionPlanHistoryActor")
  commissionStatusHistory              CommissionStatusHistory[]           @relation("CommissionHistoryActor")
  storeEarningStatusHistory            StoreEarningStatusHistory[]         @relation("StoreEarningHistoryActor")
  driverEarningStatusHistory           DriverEarningStatusHistory[]        @relation("DriverEarningHistoryActor")
  inventoryMovementsCreated            InventoryMovement[]
  carts                                Cart[]
  marketplaceCarts                     MarketplaceCart[]                   @relation("MarketplaceCartCustomer")
  marketplaceCheckouts                 MarketplaceCheckout[]               @relation("MarketplaceCheckoutCustomer")
  marketplaceOrders                    MarketplaceOrder[]                  @relation("MarketplaceOrderCustomer")
  legacyPromotionRedemptions           LegacyPromotionRedemption[]
  promotionRedemptions                 PromotionRedemption[]
  adCampaignsReviewed                  AdCampaign[]
  promoterProfile                      PromoterProfile?
  referralEvents                       ReferralEvent[]
  apiClients                           ApiClient[]
  vacanciesCreated                     Vacancy[]
  applicationDocumentsReviewed         ApplicationDocument[]
  applicationStatusChanges             ApplicationStatusHistory[]
  notifications                        Notification[]
  subscriptionContractsAsCustomer      SubscriptionContract[]              @relation("SubscriptionContractCustomer")
  subscriptionContractsAsPayer         SubscriptionContract[]              @relation("SubscriptionContractPayer")
  subscriptionReviews                  SubscriptionReview[]                @relation("SubscriptionReviewSubject")
  subscriptionAcknowledgements         SubscriptionAcknowledgement[]       @relation("SubscriptionAcknowledgementActor")
  subscriptionPlanApprovals            SubscriptionPlanVersion[]           @relation("SubscriptionPlanApprovedBy")
  subscriptionInvoicesAsPayer          SubscriptionInvoice[]               @relation("SubscriptionInvoicePayer")
  subscriptionEntitlementGrants        SubscriptionEntitlementGrant[]
  subscriptionStoreBillingAuthorities  SubscriptionStoreBillingAuthority[] @relation("SubscriptionStoreBillingAuthorityUser")
  approvedRateCards                    AdvertisingRateCardVersion[]        @relation("RateCardApprovedByUser")
  approvedCampaignVersions             AdvertisingCampaignVersion[]        @relation("CampaignVersionApprovedByUser")
  promoterAccount                      PromoterAccount?
  promoterAgreementVersionsApproved    PromoterAgreementVersion[]          @relation("PromoterAgreementApprovedBy")
  promoterProgramVersionsApproved      PromoterProgramVersion[]            @relation("PromoterProgramApprovedBy")
  recruitmentApplicantProfile          RecruitmentApplicantProfile?
  recruitmentRequisitionsRequested     RecruitmentRequisition[]            @relation("RequisitionRequestedBy")
  recruitmentRequisitionsApproved      RecruitmentRequisition[]            @relation("RequisitionApprovedBy")
  recruitmentRequisitionsHiringManager RecruitmentRequisition[]            @relation("RequisitionHiringManager")
  recruitmentReviewAssignments         RecruitmentReviewAssignment[]       @relation("ReviewerUser")
  recruitmentDecisions                 RecruitmentDecision[]               @relation("DecisionReviewer")
  recruitmentOffersApproved            RecruitmentOfferVersion[]           @relation("OfferApprovedBy")
  recruitmentRetentionPoliciesApproved RecruitmentRetentionPolicyVersion[] @relation("RetentionPolicyApprovedBy")
  VacancyApplication                   VacancyApplication[]
  legacyPaymentRefundsCreated          PaymentRefund[]                     @relation("PaymentRefundLegacyCreatedBy")
  legacyWithdrawalsReviewed            WithdrawalRequest[]                 @relation("WithdrawalRequestLegacyReviewedBy")
  catalogOperationReceipts             CatalogOperationReceipt[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model CustomerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  displayName  String?
  defaultPhone String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StoreProfile {
  id            String      @id @default(cuid())
  userId        String      @unique
  storeName     String
  contactPerson String?
  businessPhone String?
  businessEmail String?
  status        StoreStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  jobTitle    String?
  department  String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  name            String
  category        String
  description     String?
  isSystem        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([category])
  @@index([isSystem])
}

model RolePermission {
  id           String   @id @default(cuid())
  role         UserRole
  permissionId String
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
}

model UserPermission {
  id              String           @id @default(cuid())
  userId          String
  permissionId    String
  effect          PermissionEffect
  reason          String?
  createdByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user       User       @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("UserPermissionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([effect])
  @@index([createdByUserId])
}

model DriverProfile {
  id                        String                      @id @default(cuid())
  userId                    String                      @unique
  displayName               String?
  phone                     String?
  active                    Boolean                     @default(false)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  approvedAt                DateTime?
  approvedByAdminId         String?
  availability              DriverAvailability          @default(OFFLINE)
  driverCode                String                      @unique
  emergencyContactName      String?
  emergencyContactPhone     String?
  internalNotes             String?
  licenseExpiryDate         DateTime?
  licenseNumber             String?
  onboardingStatus          DriverOnboardingStatus      @default(PROFILE_INCOMPLETE)
  rejectedAt                DateTime?
  rejectedByAdminId         String?
  rejectionReason           String?
  serviceNotes              String?
  status                    DriverStatus                @default(PENDING_REVIEW)
  suspendedAt               DateTime?
  suspendedByAdminId        String?
  suspensionReason          String?
  vehicleColor              String?
  vehicleMake               String?
  vehicleModel              String?
  vehicleRegistration       String?
  vehicleType               VehicleType?
  maxConcurrentAssignments  Int                         @default(1)
  availabilityUpdatedAt     DateTime?
  availabilityRevision      Int                         @default(1)
  documents                 DriverDocument[]
  user                      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRegions            DriverServiceRegion[]
  assignments               OrderAssignment[]
  operationalEvents         OrderOperationalEvent[]
  proofOfDeliveries         ProofOfDelivery[]
  deliveryOtps              DeliveryOtp[]
  deliveryAttempts          DeliveryAttempt[]
  driverOperationCommands   DriverOperationCommand[]
  locationEvidence          DriverLocationEvidence[]
  proofEvidence             DeliveryProofEvidence[]
  currentOrders             Order[]                     @relation("CurrentOrderDriver")
  driverEarnings            DriverEarning[]
  DispatchCandidateEvidence DispatchCandidateEvidence[]

  @@index([status])
  @@index([availability])
  @@index([onboardingStatus])
  @@index([driverCode])
  @@index([availability, status])
}

model Session {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  revokedReason   String?
  revokedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model LoginHistory {
  id            String   @id @default(cuid())
  userId        String?
  email         String?
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
  @@index([createdAt])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  actorUserId String?
  type        String
  severity    String
  message     String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User?    @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)
  actor       User?    @relation("SecurityEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@index([createdAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  userId     String?
  email      String
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User?      @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([userId])
  @@index([purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Store {
  id                             String                              @id @default(cuid())
  ownerUserId                    String?
  name                           String
  slug                           String                              @unique
  status                         StoreStatus                         @default(PENDING)
  contactName                    String?
  contactEmail                   String?
  contactPhone                   String?
  addressLine1                   String?
  addressLine2                   String?
  city                           String?
  province                       String?
  postalCode                     String?
  country                        String                              @default("South Africa")
  featured                       Boolean                             @default(false)
  createdAt                      DateTime                            @default(now())
  updatedAt                      DateTime                            @updatedAt
  defaultPickupAddressId         String?
  savedAddresses                 Address[]                           @relation("StoreSavedAddresses")
  orders                         Order[]
  defaultPickupAddress           Address?                            @relation("DefaultStorePickupAddress", fields: [defaultPickupAddressId], references: [id])
  ownerUser                      User?                               @relation(fields: [ownerUserId], references: [id])
  legacySubscriptions            LegacyStoreSubscription[]
  subscriptionContracts          SubscriptionContract[]
  subscriptionReviews            SubscriptionReview[]
  subscriptionEntitlements       SubscriptionEntitlementGrant[]
  subscriptionBillingAuthorities SubscriptionStoreBillingAuthority[]
  products                       Product[]
  carts                          Cart[]
  orderItems                     OrderItem[]
  legacyPromotions               LegacyPromotion[]
  promotionCampaigns             PromotionCampaign[]
  adCampaigns                    AdCampaign[]
  storeEarnings                  StoreEarning[]
  catalogPrivateProducts         CatalogProduct[]                    @relation("CatalogProductSourceStore")
  catalogOffers                  StoreCatalogOffer[]                 @relation("CatalogStoreOffers")
  inventoryLocations             InventoryLocation[]                 @relation("CatalogInventoryLocations")
  catalogMediaAssets             CatalogMediaAsset[]                 @relation("CatalogMediaAssets")
  catalogMediaUploads            CatalogMediaUploadIntent[]          @relation("CatalogMediaUploadOwners")
  catalogModifierGroups          StoreModifierGroup[]                @relation("CatalogModifierGroups")
  catalogImportJobs              CatalogImportJob[]                  @relation("CatalogImportJobs")
  storefrontDocuments            StorefrontProductDocument[]         @relation("StorefrontDocumentStore")
  storefrontDocument             StorefrontStoreDocument?
  marketplaceCartGroups          MarketplaceCartStoreGroup[]
  marketplaceCheckoutGroups      MarketplaceCheckoutStoreGroup[]
  marketplaceStoreOrders         MarketplaceStoreOrder[]
  sellerLegalIdentities          StoreSellerLegalIdentity[]
  advertisingAccount             AdvertisingAccount?
  advertisingCampaigns           AdvertisingCampaign[]
  sponsoredCampaignVersions      AdvertisingCampaignVersion[]
  advertisingFundingAllocations  AdvertisingFundingAllocation[]

  CatalogOperationReceipt CatalogOperationReceipt[]

  @@index([ownerUserId])
  @@index([defaultPickupAddressId])
  @@index([slug])
  @@index([status])
  @@index([featured])
}

enum StoreSellerLegalIdentityStatus {
  APPROVED
  RETIRED
}

/// Approved seller-of-record authority. This deliberately excludes payout,
/// owner, moderation, and private-contact data.
model StoreSellerLegalIdentity {
  id                    String                         @id @default(cuid())
  storeId               String
  publicReference       String                         @unique
  identityVersion       String
  legalName             String
  tradingName           String?
  registrationReference String?
  vatRegistrationStatus String
  vatNumber             String?
  countryCode           String                         @default("ZA")
  termsReference        String?
  invoiceClassification String?
  status                StoreSellerLegalIdentityStatus @default(APPROVED)
  effectiveFrom         DateTime
  effectiveUntil        DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "StoreSellerLegalIdentity_store_fkey")

  @@unique([storeId, identityVersion], map: "StoreSellerLegalIdentity_store_version_key")
  @@index([storeId, status, effectiveFrom])
}

model Address {
  id               String      @id @default(cuid())
  type             AddressType
  label            String?
  contactName      String?
  contactPhone     String?
  line1            String
  line2            String?
  city             String?
  province         String?
  postalCode       String?
  country          String      @default("South Africa")
  accessNotes      String?
  latitude         Decimal?    @db.Decimal(10, 7)
  longitude        Decimal?    @db.Decimal(10, 7)
  formattedAddress String?
  placeId          String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  userId           String?
  storeId          String?
  isDefault        Boolean     @default(false)
  store            Store?      @relation("StoreSavedAddresses", fields: [storeId], references: [id], onDelete: Cascade)
  user             User?       @relation("UserSavedAddresses", fields: [userId], references: [id], onDelete: Cascade)
  dropoffOrders    Order[]     @relation("DropoffAddress")
  pickupOrders     Order[]     @relation("PickupAddress")
  defaultForStores Store[]     @relation("DefaultStorePickupAddress")

  @@index([userId])
  @@index([storeId])
  @@index([userId, type, isDefault])
  @@index([storeId, type, isDefault])
  @@index([createdAt])
}

model Order {
  id                           String                               @id @default(cuid())
  orderNumber                  String                               @unique
  source                       OrderSource
  status                       OrderStatus                          @default(PENDING)
  deliveryType                 DeliveryType
  currency                     String                               @default("ZAR")
  customerId                   String?
  storeId                      String?
  pickupAddressId              String?
  dropoffAddressId             String?
  recipientName                String?
  recipientPhone               String?
  parcelDescription            String?
  parcelCount                  Int                                  @default(1)
  scheduledFor                 DateTime?
  priceEstimate                Decimal?                             @db.Decimal(10, 2)
  pricingQuoteId               String?                              @unique
  pricingSnapshot              Json?
  pricingSubtotal              Decimal?                             @db.Decimal(12, 2)
  pricingTaxAmount             Decimal?                             @db.Decimal(12, 2)
  pricingTaxRate               Decimal?                             @db.Decimal(12, 4)
  adminNote                    String?
  customerNote                 String?
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  deliveryRegionId             String?
  distanceMeters               Int?
  durationSeconds              Int?
  routeCalculatedAt            DateTime?
  routeProvider                String?
  routeSummary                 String?
  currentDriverProfileId       String?
  custodyEstablishedAt         DateTime?
  transitStartedAt             DateTime?
  emailLogs                    EmailLog[]                           @relation("OrderEmailLogs")
  customer                     User?                                @relation("CustomerOrders", fields: [customerId], references: [id])
  deliveryRegion               DeliveryRegion?                      @relation(fields: [deliveryRegionId], references: [id])
  dropoffAddress               Address?                             @relation("DropoffAddress", fields: [dropoffAddressId], references: [id])
  pickupAddress                Address?                             @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  store                        Store?                               @relation(fields: [storeId], references: [id])
  statusHistory                OrderStatusHistory[]
  pricingAuditLogs             PricingAuditLog[]
  assignments                  OrderAssignment[]
  operationalEvents            OrderOperationalEvent[]
  proofOfDelivery              ProofOfDelivery?
  deliveryOtps                 DeliveryOtp[]
  deliveryAttempts             DeliveryAttempt[]
  driverOperationCommands      DriverOperationCommand[]
  dispatchCandidateEvidence    DispatchCandidateEvidence[]          @relation("DispatchCandidateEvidenceOrder")
  locationEvidence             DriverLocationEvidence[]
  proofEvidence                DeliveryProofEvidence[]
  payments                     Payment[]
  orderItems                   OrderItem[]
  legacyPromotionRedemptions   LegacyPromotionRedemption[]
  pricingQuote                 PricingQuote?                        @relation(fields: [pricingQuoteId], references: [id])
  currentDriverProfile         DriverProfile?                       @relation("CurrentOrderDriver", fields: [currentDriverProfileId], references: [id])
  driverEarnings               DriverEarning[]
  marketplaceStoreOrderBridge  MarketplaceStoreOrderDeliveryBridge? @relation("MarketplaceStoreOrderBridgeCourierOrder")
  dispatchCandidateEvaluations DispatchCandidateEvaluation[]

  @@index([orderNumber])
  @@index([source])
  @@index([status])
  @@index([deliveryType])
  @@index([customerId])
  @@index([storeId])
  @@index([deliveryRegionId])
  @@index([createdAt])
  @@index([scheduledFor])
  @@index([pricingQuoteId])
  @@index([currentDriverProfileId])
}

model OrderStatusHistory {
  id           String      @id @default(cuid())
  orderId      String
  status       OrderStatus
  note         String?
  actorUserId  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  internalNote String?
  actorUser    User?       @relation("ActorStatusHistory", fields: [actorUserId], references: [id])
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([actorUserId])
  @@index([createdAt])
}

model DeliveryRegion {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String?
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  baseFee              Decimal?              @db.Decimal(10, 2)
  pricingEnabled       Boolean               @default(true)
  highRiskSurcharge    Decimal?              @db.Decimal(12, 2)
