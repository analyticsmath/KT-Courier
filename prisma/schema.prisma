model WithdrawalPayoutAttempt {
  id                       String                 @id @default(cuid())
  publicReference          String                 @unique
  withdrawalId             String
  attemptNumber            Int
  method                   PayoutMethod           @default(MANUAL_EXTERNAL)
  status                   PayoutAttemptStatus    @default(RESERVED)
