model CatalogCategory {
  id              String                @id @default(cuid())
  publicReference String                @unique
  name            String
  slug            String
  description     String?
  parentId        String?
  depth           Int                   @default(0)
  path            String                @unique
  status          CatalogCategoryStatus @default(DRAFT)
  displayOrder    Int                   @default(0)
  imageAssetId    String?
  seoTitle        String?
  seoDescription  String?
  createdByUserId String
  updatedByUserId String
  version         Int                   @default(1)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  parent              CatalogCategory?             @relation("CatalogCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children            CatalogCategory[]            @relation("CatalogCategoryTree")
  productTypeMappings CatalogCategoryProductType[]
  products            CatalogProduct[]
  imageAsset          CatalogMediaAsset?           @relation("CatalogCategoryImage", fields: [imageAssetId], references: [id], onDelete: Restrict, map: "CatalogCategory_imageAsset_fkey")
  storefrontDocuments StorefrontProductDocument[]  @relation("StorefrontDocumentCategory")
  storefrontDocument  StorefrontCategoryDocument?

  @@unique([parentId, slug])
  @@index([parentId, displayOrder])
  @@index([status, path])
}

model ProductTypeDefinition {
  id                     String                      @id @default(cuid())
  publicReference        String                      @unique
  code                   String
  name                   String
  description            String?
  versionNumber          Int
  status                 ProductTypeDefinitionStatus @default(DRAFT)
  schemaVersion          Int                         @default(1)
  attributeSchema        Json
  variantSchema          Json
  complianceSchema       Json
  searchFacetSchema      Json
  createdByUserId        String
  submittedByUserId      String?
  approvedByUserId       String?
  activatedAt            DateTime?
  retiredAt              DateTime?
  supersedesDefinitionId String?
  version                Int                         @default(1)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt

  supersedes       ProductTypeDefinition?       @relation("ProductTypeSupersession", fields: [supersedesDefinitionId], references: [id], onDelete: Restrict, map: "ProductTypeDefinition_supersedes_fkey")
  supersededBy     ProductTypeDefinition[]      @relation("ProductTypeSupersession")
  categoryMappings CatalogCategoryProductType[]
  products         CatalogProduct[]

  @@unique([code, versionNumber])
  @@index([code, status])
  @@index([status, updatedAt])
}

model CatalogCategoryProductType {
  categoryId              String
  productTypeDefinitionId String
  isPrimary               Boolean  @default(false)
  displayOrder            Int      @default(0)
  createdAt               DateTime @default(now())

  category              CatalogCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict, map: "CatalogCategoryProductType_category_fkey")
  productTypeDefinition ProductTypeDefinition @relation(fields: [productTypeDefinitionId], references: [id], onDelete: Restrict, map: "CatalogCategoryProductType_definition_fkey")

  @@id([categoryId, productTypeDefinitionId])
  @@index([productTypeDefinitionId])
  @@index([categoryId, isPrimary])
}

model CatalogBrand {
