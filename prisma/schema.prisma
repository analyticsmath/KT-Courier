/// Stable administrative identity for a promotion campaign.
model PromotionCampaign {
  id              String                     @id @default(cuid())
  publicReference String                     @unique
  internalCode    String                     @unique
  ownerType       PromotionCampaignOwnerType
  ownerStoreId    String?
  status          PromotionCampaignStatus    @default(DRAFT)
  name            String
  purpose         String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  ownerStore Store?                     @relation(fields: [ownerStoreId], references: [id], onDelete: Restrict)
  versions   PromotionCampaignVersion[]

  /// Immutable versioned commercial rules for a campaign.

  @@index([ownerType, ownerStoreId])
  @@index([status])
  @@index([internalCode])
  @@index([createdAt])
}

model PromotionCampaignVersion {
  id                            String                         @id @default(cuid())
  publicReference               String                         @unique
  campaignId                    String
  versionNumber                 Int
  status                        PromotionCampaignVersionStatus @default(DRAFT)
  applicationMethod             PromotionApplicationMethod
  discountScope                 PromotionDiscountScope
  discountMechanism             PromotionDiscountMechanism
  percentageValue               Decimal?                       @db.Decimal(18, 4)
  fixedAmount                   Decimal?                       @db.Decimal(18, 2)
  maximumDiscountAmount         Decimal?                       @db.Decimal(18, 2)
  currency                      String                         @default("ZAR")
  fundingType                   PromotionFundingType
  platformFundingShareBps       Int?
  storeFundingShareBps          Int?
  minimumEligibleSubtotal       Decimal?                       @db.Decimal(18, 2)
  maximumRedemptionsGlobal      Int?
  maximumRedemptionsPerCustomer Int?
  maximumRedemptionsPerOrder    Int                            @default(1)
  startsAt                      DateTime
  endsAt                        DateTime
  stackingPolicyVersion         String                         @default("v1")
  eligibilityPolicyVersion      String                         @default("v1")
  fundingPolicyVersion          String                         @default("v1")
  refundPolicyVersion           String                         @default("v1")
  legalTermsVersion             String?
  legalTermsReference           String?
  promotionDescription          String?
  customerFacingTitle           String?
  customerFacingDescription     String?
  submittedAt                   DateTime?
  submittedByUserId             String?
  approvedAt                    DateTime?
  approvedByUserId              String?
  rejectedAt                    DateTime?
  rejectedByUserId              String?
  rejectionReason               String?
  activatedAt                   DateTime?
  pausedAt                      DateTime?
  endedAt                       DateTime?
  retiredAt                     DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  campaign            PromotionCampaign                           @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  targets             PromotionCampaignVersionTarget[]
  eligibility         PromotionCampaignVersionEligibility[]
  allowlist           PromotionCampaignVersionCustomerAllowlist[]
  codes               PromotionCode[]
  codeBatches         PromotionCodeBatch[]
  budget              PromotionBudget?
  reservations        PromotionReservation[]
  redemptions         PromotionRedemption[]
  statusHistory       PromotionStatusHistory[]
  reconciliationCases PromotionReconciliationCase[]

  /// Versioned targeting scope for a campaign version.

  @@unique([campaignId, versionNumber])
  @@index([campaignId])
  @@index([status])
  @@index([applicationMethod])
  @@index([discountScope])
  @@index([startsAt, endsAt])
  @@index([status, startsAt, endsAt])
  @@index([createdAt])
}

model PromotionCampaignVersionTarget {
  id                  String              @id @default(cuid())
  campaignVersionId   String
  targetType          PromotionTargetType
  targetMode          PromotionTargetMode @default(INCLUDE)
  targetReference     String
  targetSourceVersion String?
  createdAt           DateTime            @default(now())

  campaignVersion PromotionCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  /// Customer eligibility rules for a campaign version.

  @@index([campaignVersionId])
  @@index([targetType, targetReference])
}

model PromotionCampaignVersionEligibility {
  id                String                   @id @default(cuid())
  campaignVersionId String
  rule              PromotionEligibilityRule
  ruleValue         String?
  ruleEvidence      Json?
  createdAt         DateTime                 @default(now())

  campaignVersion PromotionCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  /// Specific customer targeting for a campaign version.

  @@index([campaignVersionId])
  @@index([rule])
}

model PromotionCampaignVersionCustomerAllowlist {
  id                String   @id @default(cuid())
  campaignVersionId String
  customerUserId    String
  createdAt         DateTime @default(now())

  campaignVersion PromotionCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade, map: "PromotionCampaignVersionCustomerAllowlist_campaignVersionId_fke")

  /// Customer-facing promotion code with HMAC-secured lookup.

  @@unique([campaignVersionId, customerUserId], map: "PromotionCampaignVersionCustomerAllowlist_campaignVersionId_cus")
  @@index([campaignVersionId])
  @@index([customerUserId])
}

model PromotionCode {
  id                            String              @id @default(cuid())
  publicReference               String              @unique
  campaignVersionId             String
  codeHmac                      String              @unique
  codeFingerprint               String
  maskedDisplay                 String
  status                        PromotionCodeStatus @default(DRAFT)
  restrictedCustomerUserId      String?
  startsAt                      DateTime?
  expiresAt                     DateTime?
  maximumRedemptions            Int?
  maximumRedemptionsPerCustomer Int?
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt

  campaignVersion     PromotionCampaignVersion      @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  batchId             String?
  batch               PromotionCodeBatch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  reservations        PromotionReservation[]
  redemptions         PromotionRedemption[]
  reconciliationCases PromotionReconciliationCase[]

  /// Batch generation tracking for promotion codes.

  @@index([campaignVersionId])
  @@index([codeHmac])
  @@index([codeFingerprint])
  @@index([status])
  @@index([restrictedCustomerUserId])
  @@index([startsAt, expiresAt])
}

model PromotionCodeBatch {
  id                String                   @id @default(cuid())
  publicReference   String                   @unique
  campaignVersionId String
  requestedCount    Int
  generatedCount    Int                      @default(0)
  status            PromotionCodeBatchStatus @default(PENDING)
  createdByUserId   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  campaignVersion PromotionCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  codes           PromotionCode[]

  /// Campaign budget authority with optimistic locking.

  @@index([campaignVersionId])
  @@index([status])
  @@index([createdAt])
}

model PromotionBudget {
  id                String                @id @default(cuid())
  campaignVersionId String                @unique
  currency          String                @default("ZAR")
  approvedAmount    Decimal               @db.Decimal(18, 2)
  dailyLimit        Decimal?              @db.Decimal(18, 2)
  reservedAmount    Decimal               @default(0) @db.Decimal(18, 2)
  committedAmount   Decimal               @default(0) @db.Decimal(18, 2)
  releasedAmount    Decimal               @default(0) @db.Decimal(18, 2)
  reversedAmount    Decimal               @default(0) @db.Decimal(18, 2)
  status            PromotionBudgetStatus @default(ACTIVE)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  campaignVersion PromotionCampaignVersion  @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  movements       PromotionBudgetMovement[]

  /// Append-only budget movement evidence.

  @@index([status])
  @@index([campaignVersionId])
}

model PromotionBudgetMovement {
  id           String                      @id @default(cuid())
  budgetId     String
  operationId  String
  requestHash  String
  movementType PromotionBudgetMovementType
  amount       Decimal                     @db.Decimal(18, 2)
  currency     String                      @default("ZAR")
  checkoutId   String?
  storeOrderId String?
  redemptionId String?
  balanceAfter Decimal                     @db.Decimal(18, 2)
  createdAt    DateTime                    @default(now())

  budget PromotionBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  /// Temporary budget and limit claim tied to a checkout review.

  @@unique([operationId, movementType])
  @@index([budgetId])
  @@index([movementType])
  @@index([checkoutId])
  @@index([storeOrderId])
  @@index([createdAt])
}

model PromotionReservation {
  id                      String                     @id @default(cuid())
  publicReference         String                     @unique
  campaignVersionId       String
  promotionCodeId         String?
  checkoutId              String
  checkoutReviewVersion   Int
  customerUserId          String?
  guestEvidenceReference  String?
  status                  PromotionReservationStatus @default(RESERVED)
  reservedDiscountAmount  Decimal                    @db.Decimal(18, 2)
  reservedPlatformFunding Decimal                    @default(0) @db.Decimal(18, 2)
  reservedStoreFunding    Decimal                    @default(0) @db.Decimal(18, 2)
  expiresAt               DateTime
  operationId             String
  requestHash             String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  campaignVersion     PromotionCampaignVersion      @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  promotionCode       PromotionCode?                @relation(fields: [promotionCodeId], references: [id], onDelete: Restrict)
  redemption          PromotionRedemption?
  reconciliationCases PromotionReconciliationCase[]

  /// Committed promotion use after payment confirmation.

  @@unique([operationId])
  @@index([campaignVersionId])
  @@index([promotionCodeId])
  @@index([checkoutId])
  @@index([customerUserId])
  @@index([status])
  @@index([expiresAt])
  @@index([createdAt])
}

model PromotionRedemption {
  id                     String                         @id @default(cuid())
  publicReference        String                         @unique
  campaignVersionId      String
  promotionCodeId        String?
  reservationId          String                         @unique
  checkoutId             String
  marketplaceOrderId     String?
  storeOrderId           String?
  customerUserId         String?
  guestEvidenceReference String?
  status                 PromotionRedemptionStatus      @default(COMMITTED)
  discountAmount         Decimal                        @db.Decimal(18, 2)
  platformFunding        Decimal                        @default(0) @db.Decimal(18, 2)
  storeFunding           Decimal                        @default(0) @db.Decimal(18, 2)
  redemptionReusePolicy  PromotionRedemptionReusePolicy @default(NEVER_RESTORE)
  operationId            String
  requestHash            String
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt

  campaignVersion     PromotionCampaignVersion       @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  promotionCode       PromotionCode?                 @relation(fields: [promotionCodeId], references: [id], onDelete: Restrict)
  reservation         PromotionReservation           @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  user                User?                          @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  allocations         PromotionFinancialAllocation[]
  reconciliationCases PromotionReconciliationCase[]

  /// Exact line/store-level allocation evidence for financial tracing.

  @@unique([operationId])
  @@index([campaignVersionId])
  @@index([promotionCodeId])
  @@index([reservationId])
  @@index([checkoutId])
  @@index([marketplaceOrderId])
  @@index([storeOrderId])
  @@index([customerUserId])
  @@index([status])
  @@index([createdAt])
}

model PromotionFinancialAllocation {
  id                  String   @id @default(cuid())
  publicReference     String   @unique
  redemptionId        String
  storeGroupReference String?
  lineReference       String?
  allocationType      String
  eligibleBasis       Decimal  @db.Decimal(18, 2)
  discountAmount      Decimal  @db.Decimal(18, 2)
  platformFunding     Decimal  @default(0) @db.Decimal(18, 2)
  storeFunding        Decimal  @default(0) @db.Decimal(18, 2)
  calculationEvidence Json
  createdAt           DateTime @default(now())

  redemption PromotionRedemption @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  /// Durable reconciliation cases for promotion operations.

  @@index([redemptionId])
  @@index([storeGroupReference])
  @@index([lineReference])
  @@index([createdAt])
}

model PromotionReconciliationCase {
  id                 String                        @id @default(cuid())
  publicReference    String                        @unique
  campaignVersionId  String?
  promotionCodeId    String?
  checkoutId         String?
  reservationId      String?
  redemptionId       String?
  marketplaceOrderId String?
  paymentId          String?
  refundId           String?
  reason             PromotionReconciliationReason
  status             PromotionReconciliationStatus @default(OPEN)
  priority           Int                           @default(0)
  safeSummary        String
  safeEvidence       Json
  resolvedAt         DateTime?
  resolvedByUserId   String?
  resolutionNotes    String?
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  campaignVersion PromotionCampaignVersion? @relation(fields: [campaignVersionId], references: [id], onDelete: Restrict)
  promotionCode   PromotionCode?            @relation(fields: [promotionCodeId], references: [id], onDelete: Restrict)
  reservation     PromotionReservation?     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  redemption      PromotionRedemption?      @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  /// Campaign version lifecycle history.

  @@index([campaignVersionId])
  @@index([promotionCodeId])
  @@index([checkoutId])
  @@index([reservationId])
  @@index([redemptionId])
  @@index([reason])
  @@index([status])
  @@index([priority, status])
  @@index([createdAt])
}

model PromotionStatusHistory {
  id                String   @id @default(cuid())
  campaignVersionId String
  fromStatus        String?
  toStatus          String
  reason            String?
  actorUserId       String?
  operationId       String?
  createdAt         DateTime @default(now())

  campaignVersion PromotionCampaignVersion @relation(fields: [campaignVersionId], references: [id], onDelete: Cascade)

  /// Durable outbox for promotion domain events.

  @@index([campaignVersionId])
  @@index([createdAt])
}

model PromotionEventIntent {
  id          String    @id @default(cuid())
  eventType   String
  payload     Json
  dedupeKey   String    @unique
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  /// Idempotency receipts for promotion operations.

  @@index([eventType])
  @@index([processedAt])
  @@index([createdAt])
