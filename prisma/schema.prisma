  @@index([commissionAccrualId], map: "RefundFundingAllocation_accrual_idx")
  @@index([commissionAllocationId], map: "RefundFundingAllocation_commissionAllocation_idx")
  @@index([storeEarningId], map: "RefundFundingAllocation_storeEarning_idx")
  @@index([driverEarningId], map: "RefundFundingAllocation_driverEarning_idx")
}

model RefundExecutionAttempt {
  id                  String                 @id @default(cuid())
  publicReference     String                 @unique
  refundId            String
  attemptNumber       Int
  provider            PaymentProvider?
  method              RefundMethod
  status              RefundAttemptStatus    @default(RESERVED)
  idempotencyKey      String                 @unique
  requestHash         String
  providerRefundId    String?
  providerPaymentId   String?
  credentialVersion   String?
  safeRequestSnapshot Json?
  safeResultSnapshot  Json?
  failureCategory     RefundFailureCategory?
  failureCode         String?
  failureMessage      String?
  initiatedByUserId   String
  completedByUserId   String?
  startedAt           DateTime?
  completedAt         DateTime?
  failedAt            DateTime?
  unknownAt           DateTime?
  version             Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  refund              PaymentRefund              @relation("RefundExecutionAttempts", fields: [refundId], references: [id], onDelete: Restrict, map: "RefundExecutionAttempt_refund_fkey")
  currentForRefund    PaymentRefund?             @relation("RefundCurrentAttempt")
  initiatedBy         User                       @relation("RefundAttemptInitiatedBy", fields: [initiatedByUserId], references: [id], onDelete: Restrict, map: "RefundExecutionAttempt_initiatedBy_fkey")
  completedBy         User?                      @relation("RefundAttemptCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict, map: "RefundExecutionAttempt_completedBy_fkey")
