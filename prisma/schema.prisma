model StoreCatalogOffer {
  id                         String                       @id @default(cuid())
  publicReference            String                       @unique
  storeId                    String
  productId                  String
  variantId                  String
  storeSku                   String
  merchantTitle              String?
  merchantDescription        String?
  status                     StoreCatalogOfferStatus      @default(DRAFT)
  publicationStatus          CatalogPublicationStatus     @default(DRAFT)
  inventoryTrackingMode      CatalogInventoryTrackingMode
  fulfilmentMode             CatalogFulfilmentMode        @default(COURIER_DELIVERY)
  sellingUnit                CatalogSellingUnit           @default(EACH)
  quantityStep               Decimal                      @default(1) @db.Decimal(18, 4)
  minimumQuantity            Decimal                      @default(1) @db.Decimal(18, 4)
  packagedQuantity           Decimal?                     @db.Decimal(18, 4)
  unitOfMeasure              String?
  primaryInventoryLocationId String?
  currentPriceVersionId      String?
  createdByUserId            String
  submittedByUserId          String?
  approvedByUserId           String?
  suspendedByUserId          String?
  version                    Int                          @default(1)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  store                    Store                        @relation("CatalogStoreOffers", fields: [storeId], references: [id], onDelete: Restrict, map: "StoreCatalogOffer_store_fkey")
  product                  CatalogProduct               @relation(fields: [productId], references: [id], onDelete: Restrict, map: "StoreCatalogOffer_product_fkey")
  variant                  CatalogProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict, map: "StoreCatalogOffer_variant_fkey")
  priceVersions            StoreOfferPriceVersion[]
  inventoryItem            CatalogInventoryItem?
  modifierGroups           StoreOfferModifierGroup[]
  moderationCases          CatalogModerationCase[]
  importRows               CatalogImportRow[]
  publicationSnapshots     CatalogPublicationSnapshot[]
  storefrontDocuments      StorefrontProductDocument[]  @relation("StorefrontDocumentOffer")
  primaryInventoryLocation InventoryLocation?           @relation("StoreCatalogOfferPrimaryInventoryLocation", fields: [primaryInventoryLocationId], references: [id], onDelete: Restrict, map: "StoreCatalogOffer_location_fkey")
  currentPriceVersion      StoreOfferPriceVersion?      @relation("StoreCatalogOfferCurrentPriceVersion", fields: [currentPriceVersionId], references: [id], onDelete: Restrict, map: "StoreCatalogOffer_currentPrice_fkey")

  @@unique([storeId, variantId])
  @@unique([storeId, storeSku])
  @@index([storeId, status])
  @@index([productId, variantId])
  @@index([publicationStatus, status])
  @@index([currentPriceVersionId])
  @@index([primaryInventoryLocationId])
}

model StoreOfferPriceVersion {
  id                String                @id @default(cuid())
