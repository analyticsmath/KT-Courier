  usedAt            DateTime?
  usedByOperationId String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "DeliveryProofEvidence_order_fkey")
  assignment    OrderAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, map: "DeliveryProofEvidence_assignment_fkey")
  driverProfile DriverProfile   @relation(fields: [driverProfileId], references: [id], onDelete: Restrict, map: "DeliveryProofEvidence_driver_fkey")

  /// Durable receipt for one logical mobile command. It is distinct from the
  /// operational timeline because a command can emit multiple lifecycle events.

  @@index([orderId, status], map: "DeliveryProofEvidence_order_status_idx")
  @@index([assignmentId, status], map: "DeliveryProofEvidence_assignment_status_idx")
  @@index([driverProfileId, status], map: "DeliveryProofEvidence_driver_status_idx")
}

model DriverOperationCommand {
