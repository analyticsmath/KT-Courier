  eligibilityStatus          MarketplaceEligibilityStatus @default(ELIGIBLE)
  eligibilityIssues          Json?
  lineFingerprint            String
  version                    Int                          @default(1)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  cart       MarketplaceCart               @relation(fields: [cartId], references: [id], onDelete: Restrict, map: "MarketplaceCartLine_cart_fkey")
  storeGroup MarketplaceCartStoreGroup     @relation(fields: [storeGroupId], references: [id], onDelete: Restrict, map: "MarketplaceCartLine_group_fkey")
