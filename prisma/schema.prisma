enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentProvider {
  PAYFAST
  OZOW
  YOCO
  PEACH
  STRIPE
  MANUAL
}

enum PaymentPurpose {
  ORDER
  REGISTRATION
  SUBSCRIPTION
  WALLET_TOPUP
  AD_PURCHASE
  MANUAL_ADJUSTMENT
}

/// Payment subjects are deliberately disjoint. Courier payments retain the
/// original Order relation; marketplace payments are bound to a checkout and
/// never fabricate a courier order.
enum PaymentSubjectType {
  COURIER_ORDER
  MARKETPLACE_CHECKOUT
  SUBSCRIPTION_INVOICE
}

enum PaymentStatus {
  CREATED
  PROVIDER_PENDING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  // Legacy Phase 4 placeholder values. Phase 10 runtime never writes these.
  PENDING
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentAttemptStatus {
  RESERVED
  REQUESTING
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  UNKNOWN
  // Legacy Phase 4 placeholder values. Phase 10 runtime never writes these.
  CREATED
  REDIRECTED
  PENDING
}

enum PaymentProviderFailureCategory {
  INVALID_REQUEST
  AUTHENTICATION
  CONFIGURATION
  DECLINED
  RATE_LIMITED
  TIMEOUT
  NETWORK
  PROVIDER_UNAVAILABLE
  MALFORMED_RESPONSE
  UNKNOWN_OUTCOME
  UNKNOWN
}

enum PaymentHistoryActorType {
  SYSTEM
  PAYER
  ADMIN
  PROVIDER
}

enum PaymentProviderEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentCustomerActionType {
  FORM_POST
  REDIRECT_GET
}

enum PaymentWebhookNormalizedStatus {
  COMPLETE
  PENDING
  FAILED
  UNKNOWN
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  REJECTED
  VERIFIED
  APPLIED
  DUPLICATE
  IGNORED_STALE
  RECONCILIATION_REQUIRED
  TEMPORARY_FAILURE
}

/// The immutable event is the only hand-off from a verified provider receipt
/// to domain-specific work. Consumer delivery state remains separate so the
/// financial evidence itself is never rewritten.
enum PaymentVerifiedEventConsumerStatus {
  PENDING
  PROCESSING
  COMPLETED
  RECONCILIATION_REQUIRED
}

enum PaymentReconciliationReason {
  UNKNOWN_OUTCOME
  CREDENTIAL_VERSION_MISMATCH
  PROVIDER_CONFIRMATION_UNAVAILABLE
  CONFLICTING_PROVIDER_STATUS
  OUT_OF_ORDER_EVENT
  AMOUNT_MISMATCH
  MERCHANT_MISMATCH
  PROVIDER_REFERENCE_CONFLICT
  UNRECOGNIZED_PROVIDER_STATUS
  APPLICATION_FAILURE_AFTER_VERIFICATION
  STALE_PROCESSING_ATTEMPT
}

enum PaymentReconciliationCaseStatus {
  OPEN
  MONITORING
  RESOLVED
  CLOSED
}

enum PaymentReconciliationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PaymentReconciliationState {
  CLEAR
  REQUIRED
  RESOLVED
}

model Payment {
  id                        String                     @id @default(cuid())
  publicReference           String                     @unique @map("paymentNumber")
  userId                    String?
  orderId                   String?                    @unique
  subjectType               PaymentSubjectType         @default(COURIER_ORDER)
  marketplaceCheckoutId     String?                    @unique
  marketplaceOrderId        String?                    @unique
  subscriptionInvoiceId     String?                    @unique
  provider                  PaymentProvider?
  purpose                   PaymentPurpose             @default(ORDER)
  status                    PaymentStatus              @default(CREATED)
  amount                    Decimal                    @db.Decimal(18, 2)
  currency                  LedgerCurrency             @default(ZAR)
  totalRefundedAmount       Decimal                    @default(0) @db.Decimal(18, 2)
  totalRefundReservedAmount Decimal                    @default(0) @db.Decimal(18, 2)
  creationIdempotencyKey    String                     @unique @map("idempotencyKey")
  creationRequestHash       String
  version                   Int                        @default(0)
  latestAttemptNumber       Int                        @default(0)
  expiresAt                 DateTime?
  succeededAt               DateTime?                  @map("paidAt")
  failedAt                  DateTime?
  cancelledAt               DateTime?
  successfulAttemptId       String?                    @unique
  successWebhookEventId     String?                    @unique
  successLedgerJournalId    String?                    @unique
  providerConfirmedAt       DateTime?
  reconciliationStatus      PaymentReconciliationState @default(CLEAR)
  metadata                  Json?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  // Empty Phase 4 compatibility columns. Ignored so provider results cannot be written on the aggregate.
  legacyProviderReference String?   @map("providerReference") @ignore
  legacyCheckoutUrl       String?   @map("checkoutUrl") @ignore
  legacyRefundedAt        DateTime? @map("refundedAt") @ignore

  user                                   User?                                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order                                  Order?                                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  marketplaceCheckout                    MarketplaceCheckout?                    @relation("MarketplaceCheckoutPayment", fields: [marketplaceCheckoutId], references: [id], onDelete: Restrict, map: "Payment_marketplaceCheckout_fkey")
  marketplaceOrder                       MarketplaceOrder?                       @relation("MarketplaceOrderPayment")
  marketplaceOrderSubject                MarketplaceOrder?                       @relation("MarketplacePaymentOrder", fields: [marketplaceOrderId], references: [id], onDelete: Restrict, map: "Payment_marketplaceOrder_fkey")
  marketplaceReservations                MarketplaceInventoryReservation[]       @relation("MarketplaceReservationPayment")
  marketplaceSettlementSnapshots         MarketplaceSettlementSnapshot[]         @relation("MarketplaceSettlementSnapshotPayment")
  marketplaceCheckoutReconciliationCases MarketplaceCheckoutReconciliationCase[] @relation("MarketplaceReconciliationPayment")
  attempts                               PaymentAttempt[]                        @relation("PaymentAttempts")
  successfulAttempt                      PaymentAttempt?                         @relation("PaymentSuccessfulAttempt", fields: [successfulAttemptId], references: [id], onDelete: Restrict)
  statusHistory                          PaymentStatusHistory[]
  webhooks                               PaymentWebhookEvent[]                   @relation("PaymentWebhookEvents")
  successWebhookEvent                    PaymentWebhookEvent?                    @relation("PaymentSuccessWebhookEvent", fields: [successWebhookEventId], references: [id], onDelete: Restrict)
  successLedgerJournal                   LedgerJournal?                          @relation("PaymentSuccessLedgerJournal", fields: [successLedgerJournalId], references: [id], onDelete: Restrict)
  reconciliationCases                    PaymentReconciliationCase[]
  refunds                                PaymentRefund[]
  subscriptionInvoice                    SubscriptionInvoice?                    @relation("SubscriptionInvoicePayment", fields: [subscriptionInvoiceId], references: [id], onDelete: Restrict, map: "Payment_subscriptionInvoice_fkey")
  verifiedEventIntent                    PaymentVerifiedEventIntent?             @relation("PaymentVerifiedEventIntentPayment")
  adCampaigns                            AdCampaign[]
  storeEarnings                          StoreEarning[]
  driverEarnings                         DriverEarning[]
  SubscriptionReconciliationCase         SubscriptionReconciliationCase[]
  SubscriptionInvoiceSettlement          SubscriptionInvoiceSettlement?

  LegacySubscriptionInvoice      LegacySubscriptionInvoice[]
  SubscriptionRenewalApplication SubscriptionRenewalApplication?

  @@index([userId])
  @@index([orderId])
  @@index([provider])
  @@index([purpose])
  @@index([status])
  @@index([createdAt])
  @@index([orderId, status])
  @@index([subjectType, marketplaceCheckoutId])
  @@index([subjectType, subscriptionInvoiceId])
  @@index([userId, createdAt])
  @@index([provider, status])
  @@index([reconciliationStatus, updatedAt])
}

model PaymentAttempt {
  id                        String                          @id @default(cuid())
  publicReference           String?                         @unique
  paymentId                 String
  attemptNumber             Int
  provider                  PaymentProvider
  idempotencyKey            String                          @unique
  requestHash               String
  merchantReference         String                          @unique
  providerReference         String?
  status                    PaymentAttemptStatus            @default(RESERVED)
  amount                    Decimal                         @db.Decimal(18, 2)
  currency                  LedgerCurrency                  @default(ZAR)
  redirectUrl               String?
  providerEnvironment       PaymentProviderEnvironment?
  checkoutActionType        PaymentCustomerActionType?
  checkoutPreparedAt        DateTime?
  providerProtocolVersion   String?
  configurationFingerprint  String?
  providerCredentialVersion String?
  expiresAt                 DateTime?
  providerStatusCode        String?
  failureCategory           PaymentProviderFailureCategory?
  failureCode               String?                         @map("errorCode")
  failureMessage            String?                         @map("errorMessage")
  requestSnapshot           Json?
  resultSnapshot            Json?                           @map("providerPayload")
  startedAt                 DateTime?
  completedAt               DateTime?
  providerConfirmedAt       DateTime?
  version                   Int                             @default(0)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt

  payment              Payment                     @relation("PaymentAttempts", fields: [paymentId], references: [id], onDelete: Cascade)
  history              PaymentStatusHistory[]
  webhookEvents        PaymentWebhookEvent[]       @relation("AttemptWebhookEvents")
  reconciliationCases  PaymentReconciliationCase[]
  successfulForPayment Payment?                    @relation("PaymentSuccessfulAttempt")
  verifiedEventIntent  PaymentVerifiedEventIntent? @relation("PaymentVerifiedEventIntentSuccessfulAttempt")

  @@unique([paymentId, attemptNumber])
  @@unique([provider, providerReference])
  @@index([paymentId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([paymentId, status])
  @@index([provider, providerCredentialVersion, status])
}

model PaymentStatusHistory {
  id         String                  @id @default(cuid())
  paymentId  String
  attemptId  String?
  fromStatus PaymentStatus?
  toStatus   PaymentStatus
  reasonCode String?
  actorType  PaymentHistoryActorType @default(SYSTEM)
  actorId    String?
  metadata   Json?
  createdAt  DateTime                @default(now())

  payment Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempt PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@index([attemptId])
  @@index([toStatus, createdAt])
}

model PaymentWebhookEvent {
  id                    String                         @id @default(cuid())
  publicReference       String                         @unique
  provider              PaymentProvider
  environment           PaymentProviderEnvironment
  eventFingerprint      String                         @unique
  merchantReference     String
  providerPaymentId     String?
  providerStatus        String
  normalizedStatus      PaymentWebhookNormalizedStatus
  processingStatus      PaymentWebhookProcessingStatus @default(RECEIVED) @map("itnProcessingStatus")
  paymentId             String?
  attemptId             String?
  ledgerJournalId       String?                        @unique
  credentialVersion     String?
  sourceAddress         String?
  sourceAddressVerified Boolean                        @default(false)
  signatureVerified     Boolean                        @default(false)
  merchantVerified      Boolean                        @default(false)
  amountVerified        Boolean                        @default(false)
  providerDataVerified  Boolean                        @default(false)
  safePayloadSnapshot   Json?
  unknownFieldCount     Int                            @default(0)
  rejectionCode         String?
  reconciliationReason  PaymentReconciliationReason?
  receivedAt            DateTime                       @default(now())
  verifiedAt            DateTime?
  appliedAt             DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @default(now()) @updatedAt

  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyProviderEventId  String?           @map("providerEventId")
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyEventType        String?           @map("eventType") @ignore
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyProcessingStatus ProcessingStatus? @map("processingStatus") @ignore
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacySignatureValid   Boolean?          @map("signatureValid") @ignore
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyPayload          Json?             @map("payload") @ignore
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyErrorMessage     String?           @map("errorMessage") @ignore
  /// Legacy Phase 4 compatibility field. Must remain null. Not used by the Phase 12 Payfast verification pipeline.
  legacyProcessedAt      DateTime?         @map("processedAt") @ignore

  payment             Payment?                    @relation("PaymentWebhookEvents", fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "PaymentWebhookEvent_paymentId_phase12_restrict_fkey")
  attempt             PaymentAttempt?             @relation("AttemptWebhookEvents", fields: [attemptId], references: [id], onDelete: Restrict)
  ledgerJournal       LedgerJournal?              @relation("WebhookLedgerJournal", fields: [ledgerJournalId], references: [id], onDelete: Restrict)
  successForPayment   Payment?                    @relation("PaymentSuccessWebhookEvent")
  reconciliationCases PaymentReconciliationCase[]
  verifiedEventIntent PaymentVerifiedEventIntent? @relation("PaymentVerifiedEventIntentWebhookEvent")

  /// Durable outbox committed in the same transaction as verified payment
  /// success and its receipt journal. It contains only immutable safe
  /// references; raw provider payloads and credentials never enter this model.
  @@unique([provider, legacyProviderEventId], map: "PaymentWebhookEvent_provider_providerEventId_key")
  @@index([paymentId])
  @@index([attemptId])
  @@index([provider])
  @@index([environment, receivedAt])
  @@index([providerStatus])
  @@index([normalizedStatus])
  @@index([processingStatus], map: "PaymentWebhookEvent_itnProcessingStatus_idx")
  @@index([receivedAt])
  @@index([merchantReference])
  @@index([provider, providerPaymentId])
  @@index([paymentId, attemptId, receivedAt])
  @@index([legacyEventType], map: "PaymentWebhookEvent_eventType_idx")
  @@index([legacyProcessingStatus], map: "PaymentWebhookEvent_processingStatus_idx")
}

model PaymentVerifiedEventIntent {
  id                  String             @id @default(cuid())
  publicReference     String             @unique
  eventIdentity       String             @unique
  eventType           String
  paymentId           String             @unique
  successfulAttemptId String             @unique
  webhookEventId      String             @unique
  paymentReference    String
  subjectType         PaymentSubjectType
  subjectReference    String
  payerUserId         String?
  amount              Decimal            @db.Decimal(18, 2)
  currency            LedgerCurrency
  provider            PaymentProvider
  verifiedAt          DateTime
  schemaVersion       Int                @default(1)
  createdAt           DateTime           @default(now())

  deliveries        PaymentVerifiedEventConsumerReceipt[]
  payment           Payment                               @relation("PaymentVerifiedEventIntentPayment", fields: [paymentId], references: [id], onDelete: Restrict, map: "PaymentVerifiedEventIntent_paymentId_fkey")
  successfulAttempt PaymentAttempt                        @relation("PaymentVerifiedEventIntentSuccessfulAttempt", fields: [successfulAttemptId], references: [id], onDelete: Restrict, map: "PaymentVerifiedEventIntent_successfulAttemptId_fkey")
  webhookEvent      PaymentWebhookEvent                   @relation("PaymentVerifiedEventIntentWebhookEvent", fields: [webhookEventId], references: [id], onDelete: Restrict, map: "PaymentVerifiedEventIntent_webhookEventId_fkey")

  /// Mutable processor receipt only. It cannot alter the immutable verified
  /// payment fact represented by PaymentVerifiedEventIntent.

  @@index([eventType, createdAt])
  @@index([subjectType, createdAt])
}

model PaymentVerifiedEventConsumerReceipt {
  id            String                             @id @default(cuid())
  eventIntentId String
  consumer      String
  operationId   String                             @unique
  status        PaymentVerifiedEventConsumerStatus @default(PENDING)
  attemptCount  Int                                @default(1)
  lastErrorCode String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime                           @default(now())
  updatedAt     DateTime                           @updatedAt

  eventIntent PaymentVerifiedEventIntent @relation(fields: [eventIntentId], references: [id], onDelete: Restrict)

  @@unique([eventIntentId, consumer])
  @@index([status, updatedAt])
}

model PaymentReconciliationCase {
  id               String                          @id @default(cuid())
  publicReference  String                          @unique
  caseKey          String                          @unique
  paymentId        String
  attemptId        String?
  webhookEventId   String?
  provider         PaymentProvider
  reason           PaymentReconciliationReason
  status           PaymentReconciliationCaseStatus @default(OPEN)
  priority         PaymentReconciliationPriority   @default(MEDIUM)
  summary          String
  safeEvidence     Json?
  observationCount Int                             @default(1)
  openedAt         DateTime                        @default(now())
  lastObservedAt   DateTime                        @default(now())
  resolvedAt       DateTime?
  resolutionCode   String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  payment      Payment              @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  attempt      PaymentAttempt?      @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  webhookEvent PaymentWebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: Restrict)

  @@index([status, priority, lastObservedAt])
  @@index([paymentId, status])
  @@index([attemptId, status])
  @@index([webhookEventId])
  @@index([provider, reason, status])
}

