  checkoutLineSnapshot MarketplaceCheckoutLineSnapshot            @relation(fields: [checkoutLineSnapshotId], references: [id], onDelete: Restrict, map: "MarketplaceCheckoutSettlementLineAllocation_line_fkey")

  @@unique([settlementEvidenceId, stableOrderingKey], map: "MarketplaceCheckoutSettlementLineAllocation_evidence_key")
