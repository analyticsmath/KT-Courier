model MarketplaceCheckoutLineSnapshot {
  id                  String             @id @default(cuid())
  checkoutId          String
  storeGroupId        String
  /// A re-review appends a new immutable set; historical review evidence is
  /// retained instead of overwriting the commercial record.
  reviewVersion       Int                @default(1)
  productReference    String
  variantReference    String
  offerReference      String
  storeReference      String
  productTitle        String
  variantTitle        String
  storeSku            String?
  quantity            Int
  sellingUnit         CatalogSellingUnit
  publicationVersion  String
  priceVersion        String
  baseUnitPrice       Decimal            @db.Decimal(18, 2)
  modifierUnitTotal   Decimal            @db.Decimal(18, 2)
  effectiveUnitPrice  Decimal            @db.Decimal(18, 2)
  lineTotal           Decimal            @db.Decimal(18, 2)
  currency            LedgerCurrency     @default(ZAR)
  inventoryItemId     String?
  inventoryLocationId String?
  taxTreatment        String
  includedTaxAmount   Decimal?           @db.Decimal(18, 2)
  createdAt           DateTime           @default(now())

  checkout             MarketplaceCheckout                          @relation(fields: [checkoutId], references: [id], onDelete: Restrict, map: "MarketplaceCheckoutLineSnapshot_checkout_fkey")
  storeGroup           MarketplaceCheckoutStoreGroup                @relation(fields: [storeGroupId], references: [id], onDelete: Restrict, map: "MarketplaceCheckoutLineSnapshot_group_fkey")
  modifiers            MarketplaceCheckoutModifierSnapshot[]
  settlementAllocation MarketplaceCheckoutSettlementLineAllocation?

  @@index([checkoutId, reviewVersion])
  @@index([storeGroupId])
}

model MarketplaceCheckoutModifierSnapshot {
  id                     String   @id @default(cuid())
  checkoutLineSnapshotId String
  groupReference         String
  groupName              String
  optionReference        String
  optionName             String
  quantity               Int
  priceDelta             Decimal  @db.Decimal(18, 2)
  totalContribution      Decimal  @db.Decimal(18, 2)
  sourceVersion          String
  createdAt              DateTime @default(now())

  checkoutLineSnapshot MarketplaceCheckoutLineSnapshot @relation(fields: [checkoutLineSnapshotId], references: [id], onDelete: Restrict, map: "MarketplaceCheckoutModifierSnapshot_line_fkey")

  /// Immutable authority produced by a single checkout review for one store.
  /// It contains only approved seller-of-record and financial reconstruction data.

  @@index([checkoutLineSnapshotId])
}

model MarketplaceCheckoutStoreSettlementEvidence {
  id                           String   @id @default(cuid())
  publicReference              String   @unique
  checkoutId                   String
  checkoutStoreGroupId         String
  reviewVersion                Int
  commercialFingerprint        String
  evidenceVersion              String
  sellerIdentityReference      String
  sellerIdentityVersion        String
  sellerIdentityEvidence       Json
  commissionPlanReference      String
  commissionPlanVersion        Int
  commissionCalculationVersion String
  commissionEvidence           Json
  sellerSettlementBasisAmount  Decimal  @db.Decimal(18, 2)
  attributedCommissionAmount   Decimal  @db.Decimal(18, 2)
  netStoreEarningAmount        Decimal  @db.Decimal(18, 2)
  deliveryFeeExcludedAmount    Decimal  @db.Decimal(18, 2)
  taxEvidence                  Json
  policyReferences             Json
  sourceEvidenceFingerprint    String
  createdAt                    DateTime @default(now())

  checkout            MarketplaceCheckout                           @relation(fields: [checkoutId], references: [id], onDelete: Restrict, map: "MarketplaceCheckoutStoreSettlementEvidence_checkout_fkey")
