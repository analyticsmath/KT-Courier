model MarketplaceCheckout {
  id                      String                    @id @default(cuid())
  publicReference         String                    @unique
  cartId                  String
  customerUserId          String?
  guestAccessTokenHash    String?
  guestAccessTokenVersion Int                       @default(1)
  status                  MarketplaceCheckoutStatus @default(CREATED)
  currency                LedgerCurrency            @default(ZAR)
  contactSnapshotId       String?                   @unique
  addressSnapshotId       String?                   @unique
  merchandiseSubtotal     Decimal                   @default(0) @db.Decimal(18, 2)
  modifierSubtotal        Decimal                   @default(0) @db.Decimal(18, 2)
  deliveryFeeTotal        Decimal                   @default(0) @db.Decimal(18, 2)
  grandTotal              Decimal                   @default(0) @db.Decimal(18, 2)
  reviewVersion           Int                       @default(1)
  commercialFingerprint   String?
  acceptedFingerprint     String?
  changesAcknowledgedAt   DateTime?
  termsAcknowledgedAt     DateTime?
  reviewAcceptedAt        DateTime?
  reservationExpiresAt    DateTime?
  riskDecision            MarketplaceRiskDecision   @default(PASS)
  riskReasonCodes         Json?
  confirmedAt             DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  expiredAt               DateTime?
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  cart                MarketplaceCart                              @relation(fields: [cartId], references: [id], onDelete: Restrict, map: "MarketplaceCheckout_cart_fkey")
  customer            User?                                        @relation("MarketplaceCheckoutCustomer", fields: [customerUserId], references: [id], onDelete: Restrict, map: "MarketplaceCheckout_customer_fkey")
  contactSnapshot     MarketplaceCheckoutContactSnapshot?          @relation("MarketplaceCheckoutContactSnapshot", fields: [contactSnapshotId], references: [id], onDelete: Restrict, map: "MarketplaceCheckout_contact_fkey")
  addressSnapshot     MarketplaceCheckoutAddressSnapshot?          @relation("MarketplaceCheckoutAddressSnapshot", fields: [addressSnapshotId], references: [id], onDelete: Restrict, map: "MarketplaceCheckout_address_fkey")
  payment             Payment?                                     @relation("MarketplaceCheckoutPayment")
  storeGroups         MarketplaceCheckoutStoreGroup[]
  lines               MarketplaceCheckoutLineSnapshot[]
  changes             MarketplaceCheckoutChange[]
  operations          MarketplaceCheckoutOperation[]
  acknowledgements    MarketplaceCheckoutAcknowledgement[]
  reservations        MarketplaceInventoryReservation[]
  settlementEvidence  MarketplaceCheckoutStoreSettlementEvidence[]
  settlementSnapshots MarketplaceSettlementSnapshot[]
  marketplaceOrder    MarketplaceOrder?
  reconciliationCases MarketplaceCheckoutReconciliationCase[]

  @@index([cartId, status])
  @@index([customerUserId, createdAt])
  @@index([guestAccessTokenHash])
  @@index([status, reservationExpiresAt])
}

