  slug             String             @unique
  status           CatalogBrandStatus @default(PENDING)
  logoAssetId      String?
  website          String?
  createdByUserId  String
  approvedByUserId String?
  version          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  products  CatalogProduct[]
  logoAsset CatalogMediaAsset? @relation("CatalogBrandLogo", fields: [logoAssetId], references: [id], onDelete: Restrict, map: "CatalogBrand_logoAsset_fkey")

  @@index([status, name])
}

model CatalogProduct {
  id                       String                   @id @default(cuid())
  publicReference          String                   @unique
  scope                    CatalogProductScope
  sourceStoreId            String?
  productTypeDefinitionId  String
  productTypeVersionNumber Int
  primaryCategoryId        String
  brandId                  String?
  title                    String
  normalizedTitle          String
  shortDescription         String?
  description              String?
  manufacturer             String?
  modelNumber              String?
  countryOfOrigin          String?
  condition                CatalogProductCondition  @default(NEW)
  attributeValues          Json
  complianceValues         Json
  status                   CatalogProductStatus     @default(DRAFT)
  moderationStatus         CatalogModerationStatus  @default(NOT_SUBMITTED)
  publicationStatus        CatalogPublicationStatus @default(DRAFT)
  slug                     String
  seoTitle                 String?
  seoDescription           String?
  qualityScore             Int                      @default(0)
  qualityIssues            Json
  createdByUserId          String
  submittedByUserId        String?
  approvedByUserId         String?
  suspendedByUserId        String?
  suspensionReasonCode     String?
  version                  Int                      @default(1)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  sourceStore           Store?                       @relation("CatalogProductSourceStore", fields: [sourceStoreId], references: [id], onDelete: Restrict, map: "CatalogProduct_sourceStore_fkey")
  productTypeDefinition ProductTypeDefinition        @relation(fields: [productTypeDefinitionId], references: [id], onDelete: Restrict, map: "CatalogProduct_definition_fkey")
  primaryCategory       CatalogCategory              @relation(fields: [primaryCategoryId], references: [id], onDelete: Restrict, map: "CatalogProduct_category_fkey")
  brand                 CatalogBrand?                @relation(fields: [brandId], references: [id], onDelete: Restrict, map: "CatalogProduct_brand_fkey")
  variants              CatalogProductVariant[]
  options               CatalogProductOption[]
  media                 CatalogProductMedia[]
  offers                StoreCatalogOffer[]
  moderationCases       CatalogModerationCase[]
  duplicateSources      CatalogDuplicateCandidate[]  @relation("CatalogDuplicateSource")
  duplicateCandidates   CatalogDuplicateCandidate[]  @relation("CatalogDuplicateCandidate")
  importRows            CatalogImportRow[]
  publicationSnapshots  CatalogPublicationSnapshot[]
  storefrontDocuments   StorefrontProductDocument[]  @relation("StorefrontDocumentProduct")

  @@unique([scope, sourceStoreId, slug])
  @@index([sourceStoreId, status])
  @@index([primaryCategoryId, status])
  @@index([productTypeDefinitionId, productTypeVersionNumber], map: "CatalogProduct_type_version_idx")
  @@index([brandId, normalizedTitle], map: "CatalogProduct_brand_title_idx")
  @@index([moderationStatus, status], map: "CatalogProduct_moderation_status_idx")
}

model CatalogProductVariant {
  id                String               @id @default(cuid())
