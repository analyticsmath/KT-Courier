model PaymentRefund {
  id                        String           @id @default(cuid())
  publicReference           String           @unique
  paymentId                 String
  customerUserId            String?
  method                    RefundMethod
  amount                    Decimal          @db.Decimal(18, 2)
  currency                  LedgerCurrency   @default(ZAR)
  status                    RefundStatus     @default(REQUESTED)
  reasonCode                RefundReasonCode
  customerNote              String?
  financeNote               String?
  creationIdempotencyKey    String           @unique
  creationRequestHash       String
  policyVersion             Int              @default(1)
  reserveLedgerJournalId    String           @unique
  releaseLedgerJournalId    String?          @unique
  completionLedgerJournalId String?          @unique
  currentAttemptId          String?          @unique
  latestAttemptNumber       Int              @default(0)
  approvedByUserId          String?
  approvedAt                DateTime?
  rejectedByUserId          String?
  rejectedAt                DateTime?
  cancelledByUserId         String?
  cancelledAt               DateTime?
  completedByUserId         String?
  completedAt               DateTime?
  reconciliationRequiredAt  DateTime?
  version                   Int              @default(0)
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  // Phase 4 placeholder columns are retained physically for migration safety
  // and excluded from every Phase 15 operational contract.
  legacyCurrency          String        @default("ZAR") @map("legacyCurrency")
  legacyReason            String?       @map("legacyReason") @ignore
  legacyProviderReference String?       @map("legacyProviderReference") @ignore
  legacyPaymentStatus     PaymentStatus @default(PENDING) @map("legacyPaymentStatus")
  legacyMetadata          Json?         @map("legacyMetadata") @ignore
  legacyCreatedByUserId   String?       @map("legacyCreatedByUserId")
  legacyCreatedBy         User?         @relation("PaymentRefundLegacyCreatedBy", fields: [legacyCreatedByUserId], references: [id], onDelete: SetNull, map: "PaymentRefund_createdByUserId_fkey")

  payment                                  Payment                                   @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  customer                                 User?                                     @relation("RefundCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  approvedBy                               User?                                     @relation("RefundApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  rejectedBy                               User?                                     @relation("RefundRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  cancelledBy                              User?                                     @relation("RefundCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  completedBy                              User?                                     @relation("RefundCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  reserveLedgerJournal                     LedgerJournal                             @relation("RefundReserveLedgerJournal", fields: [reserveLedgerJournalId], references: [id], onDelete: Restrict, map: "PaymentRefund_reserveJournal_fkey")
  releaseLedgerJournal                     LedgerJournal?                            @relation("RefundReleaseLedgerJournal", fields: [releaseLedgerJournalId], references: [id], onDelete: Restrict, map: "PaymentRefund_releaseJournal_fkey")
  completionLedgerJournal                  LedgerJournal?                            @relation("RefundCompletionLedgerJournal", fields: [completionLedgerJournalId], references: [id], onDelete: Restrict, map: "PaymentRefund_completionJournal_fkey")
  currentAttempt                           RefundExecutionAttempt?                   @relation("RefundCurrentAttempt", fields: [currentAttemptId], references: [id], onDelete: Restrict, map: "PaymentRefund_currentAttempt_fkey")
  attempts                                 RefundExecutionAttempt[]                  @relation("RefundExecutionAttempts")
  fundingAllocations                       RefundFundingAllocation[]
  statusHistory                            RefundStatusHistory[]
  reconciliationCases                      RefundReconciliationCase[]
  storeEarningReconciliations              StoreEarningReconciliationCase[]
  driverEarningReconciliations             DriverEarningReconciliationCase[]
  marketplaceStoreOrderAdjustments         MarketplaceStoreOrderAdjustment[]         @relation("MarketplaceStoreOrderAdjustmentRefund")
  marketplaceStoreOrderReconciliationCases MarketplaceStoreOrderReconciliationCase[] @relation("MarketplaceStoreOrderReconciliationRefund")
  subscriptionRefundAdjustments            SubscriptionRefundAdjustment[]

  @@index([paymentId, createdAt])
  @@index([customerUserId, createdAt])
  @@index([status, createdAt], map: "PaymentRefund_refundStatus_createdAt_idx")
  @@index([method, status], map: "PaymentRefund_method_refundStatus_idx")
  @@index([reconciliationRequiredAt])
  @@index([createdAt], map: "PaymentRefund_createdAt_idx")
