model RefundStatusHistory {
  id           String                 @id @default(cuid())
  refundId     String
  attemptId    String?
  fromStatus   RefundStatus?
  toStatus     RefundStatus
  actorType    RefundHistoryActorType @default(SYSTEM)
  actorUserId  String?
  operationId  String?
  reasonCode   String
  safeMetadata Json?
  createdAt    DateTime               @default(now())

  refund  PaymentRefund           @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "RefundStatusHistory_refund_fkey")
  attempt RefundExecutionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, map: "RefundStatusHistory_attempt_fkey")
  actor   User?                   @relation("RefundHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull, map: "RefundStatusHistory_actor_fkey")

  @@unique([refundId, operationId], map: "RefundStatusHistory_refund_operation_key")
  @@index([refundId, createdAt], map: "RefundStatusHistory_refund_createdAt_idx")
  @@index([attemptId], map: "RefundStatusHistory_attempt_idx")
  @@index([toStatus, createdAt], map: "RefundStatusHistory_status_createdAt_idx")
}

model RefundReconciliationCase {
  id               String                         @id @default(cuid())
  publicReference  String                         @unique
  caseKey          String                         @unique
  refundId         String
  attemptId        String?
  reason           RefundReconciliationReason
  status           RefundReconciliationCaseStatus @default(OPEN)
  priority         RefundReconciliationPriority   @default(MEDIUM)
  observationCount Int                            @default(1)
  safeSummary      String
  safeEvidence     Json?
  openedAt         DateTime                       @default(now())
  lastObservedAt   DateTime                       @default(now())
  resolvedAt       DateTime?
  resolutionCode   String?
  resolvedByUserId String?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  refund     PaymentRefund           @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "RefundReconciliationCase_refund_fkey")
  attempt    RefundExecutionAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict, map: "RefundReconciliationCase_attempt_fkey")
  resolvedBy User?                   @relation("RefundReconciliationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull, map: "RefundReconciliationCase_resolvedBy_fkey")

  @@index([status, priority, lastObservedAt])
  @@index([refundId, status], map: "RefundReconciliationCase_refund_status_idx")
  @@index([attemptId, status], map: "RefundReconciliationCase_attempt_status_idx")
  @@index([reason, status])
}

