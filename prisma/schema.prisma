model Wallet {
  id               String          @id @default(cuid())
  ownerType        WalletOwnerType
  ownerId          String
  currency         String          @default("ZAR")
  availableBalance Decimal         @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal         @default(0) @db.Decimal(12, 2)
  lockedBalance    Decimal         @default(0) @db.Decimal(12, 2)
  status           RecordStatus    @default(ACTIVE)
  version          Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  transactions       WalletTransaction[]
  withdrawals        WithdrawalRequest[]
  payoutDestinations PayoutDestination[]
  accounts           LedgerAccount[]
  storeEarnings      StoreEarning[]
  driverEarnings     DriverEarning[]

  @@unique([ownerType, ownerId, currency])
  @@index([ownerType, ownerId])
  @@index([status])
  @@index([createdAt])
}

model LedgerAccount {
  id             String                @id @default(cuid())
  walletId       String
  code           String                @unique
  purpose        LedgerAccountPurpose
  category       LedgerAccountCategory
  currency       LedgerCurrency        @default(ZAR)
  status         LedgerAccountStatus   @default(ACTIVE)
  allowNegative  Boolean               @default(false)
  currentBalance Decimal               @default(0) @db.Decimal(18, 2)
  debitTotal     Decimal               @default(0) @db.Decimal(18, 2)
  creditTotal    Decimal               @default(0) @db.Decimal(18, 2)
  version        Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  wallet                   Wallet                    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  entries                  LedgerEntry[]
  withdrawalSourceFor      WithdrawalRequest[]       @relation("WithdrawalSourceAccount")
  withdrawalHeldFor        WithdrawalRequest[]       @relation("WithdrawalHeldAccount")
  commissionAllocations    CommissionAllocation[]    @relation("CommissionAllocationAccount")
  refundFundingAllocations RefundFundingAllocation[] @relation("RefundFundingAccount")
  storeEarningsPayableFor  StoreEarning[]            @relation("StoreEarningPayableAccount")
  driverEarningsPayableFor DriverEarning[]           @relation("DriverEarningPayableAccount")

  @@unique([walletId, purpose, currency])
  @@index([walletId, status])
  @@index([category, currency])
}

model LedgerJournal {
  id                  String            @id @default(cuid())
  reference           String            @unique
  type                LedgerJournalType
  currency            LedgerCurrency    @default(ZAR)
  idempotencyKey      String            @unique
  requestHash         String
  sourceReference     String?           @unique
  correlationId       String?
  memo                String?
  metadata            Json?
  policyVersion       String
  totalDebits         Decimal           @db.Decimal(18, 2)
  totalCredits        Decimal           @db.Decimal(18, 2)
  reversalOfJournalId String?           @unique
  postedAt            DateTime          @default(now())
  createdByUserId     String?
  createdAt           DateTime          @default(now())

  entries                        LedgerEntry[]
  subscriptionSettlements        SubscriptionInvoiceSettlement[]       @relation("SubscriptionSettlementJournal")
  subscriptionRevenueEntries     SubscriptionRevenueRecognitionEntry[] @relation("SubscriptionRevenueRecognitionJournal")
  createdBy                      User?                                 @relation("LedgerJournalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  originalJournal                LedgerJournal?                        @relation("LedgerJournalReversal", fields: [reversalOfJournalId], references: [id], onDelete: Restrict)
  reversalJournal                LedgerJournal?                        @relation("LedgerJournalReversal")
  successfulForPayment           Payment?                              @relation("PaymentSuccessLedgerJournal")
  webhookEvent                   PaymentWebhookEvent?                  @relation("WebhookLedgerJournal")
  withdrawalReserve              WithdrawalRequest?                    @relation("WithdrawalReserveLedgerJournal")
  withdrawalRelease              WithdrawalRequest?                    @relation("WithdrawalReleaseLedgerJournal")
  withdrawalPayout               WithdrawalRequest?                    @relation("WithdrawalPayoutLedgerJournal")
  commissionAccrual              CommissionAccrual?                    @relation("CommissionAccrualLedgerJournal")
  commissionReversal             CommissionAccrual?                    @relation("CommissionReversalLedgerJournal")
  refundReserve                  PaymentRefund?                        @relation("RefundReserveLedgerJournal")
  refundRelease                  PaymentRefund?                        @relation("RefundReleaseLedgerJournal")
  refundCompletion               PaymentRefund?                        @relation("RefundCompletionLedgerJournal")
  storeEarningAccrual            StoreEarning?                         @relation("StoreEarningAccrualLedgerJournal")
  storeEarningRelease            StoreEarning?                         @relation("StoreEarningReleaseLedgerJournal")
  storeEarningReversal           StoreEarning?                         @relation("StoreEarningReversalLedgerJournal")
  driverEarningAccrual           DriverEarning?                        @relation("DriverEarningAccrualLedgerJournal")
  driverEarningRelease           DriverEarning?                        @relation("DriverEarningReleaseLedgerJournal")
  driverEarningReversal          DriverEarning?                        @relation("DriverEarningReversalLedgerJournal")
  advertisingFundingMovements    AdvertisingFundingMovement[]
  clickCharges                   AdvertisingClickCharge[]              @relation("ClickChargeJournal")
  reversedClickCharges           AdvertisingClickCharge[]              @relation("ClickReversalJournal")
  advertisingReconciliationCases AdvertisingReconciliationCase[]

  SubscriptionRefundAdjustment SubscriptionRefundAdjustment?

  @@index([type, postedAt])
  @@index([currency, postedAt])
  @@index([correlationId])
  @@index([createdByUserId])
}

model LedgerEntry {
  id        String               @id @default(cuid())
  journalId String
  accountId String
  sequence  Int
  direction LedgerEntryDirection
  amount    Decimal              @db.Decimal(18, 2)
  lineCode  String
  memo      String?
  createdAt DateTime             @default(now())

  journal LedgerJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([journalId, sequence])
  @@unique([journalId, lineCode])
  @@index([accountId, createdAt])
  @@index([journalId])
}

model WalletTransaction {
  id              String                     @id @default(cuid())
  walletId        String
  direction       WalletTransactionDirection
  type            WalletTransactionType
  status          WalletTransactionStatus    @default(PENDING)
  amount          Decimal                    @db.Decimal(12, 2)
  currency        String                     @default("ZAR")
  balanceBefore   Decimal?                   @db.Decimal(12, 2)
  balanceAfter    Decimal?                   @db.Decimal(12, 2)
  referenceType   String?
  referenceId     String?
  idempotencyKey  String?                    @unique
  description     String?
  metadata        Json?
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  postedAt        DateTime?

  wallet    Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  createdBy User?  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@index([direction])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdByUserId])
  @@index([createdAt])
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PROCESSING
  PAID
  REJECTED
  CANCELLED
  RECONCILIATION_REQUIRED
}

model WithdrawalRequest {
  id                       String           @id @default(cuid())
  publicReference          String           @unique @map("withdrawalNumber")
  walletId                 String
  ownerType                WalletOwnerType
  ownerId                  String
  sourceAccountId          String
  heldAccountId            String
  payoutDestinationId      String
  amount                   Decimal          @db.Decimal(18, 2)
  currency                 LedgerCurrency   @default(ZAR)
  status                   WithdrawalStatus @default(REQUESTED)
  creationIdempotencyKey   String           @unique
  creationRequestHash      String
  policyVersion            Int
  version                  Int              @default(0)
  latestAttemptNumber      Int              @default(0)
  reserveLedgerJournalId   String           @unique
  releaseLedgerJournalId   String?          @unique
  payoutLedgerJournalId    String?          @unique
  currentPayoutAttemptId   String?          @unique
  requestedByUserId        String
  approvedByUserId         String?
  approvedAt               DateTime?
  rejectedByUserId         String?
  rejectedAt               DateTime?
  rejectionReasonCode      String?
  cancellationReasonCode   String?
  cancelledByUserId        String?
  cancelledAt              DateTime?
  completedByUserId        String?
  completedAt              DateTime?
  reconciliationRequiredAt DateTime?
  createdAt                DateTime         @default(now()) @map("requestedAt")
  updatedAt                DateTime         @updatedAt

  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.

  legacyReviewedByUserId String?   @map("reviewedByUserId") @ignore
  legacyReviewedBy       User?     @relation("WithdrawalRequestLegacyReviewedBy", fields: [legacyReviewedByUserId], references: [id], onDelete: SetNull, map: "WithdrawalRequest_reviewedByUserId_fkey") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyBankName         String?   @map("bankName") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyAccountHolder    String?   @map("accountHolder") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyAccountLast4     String?   @map("accountLast4") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyRejectionReason  String?   @map("rejectionReason") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyMetadata         Json?     @map("metadata") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyReviewedAt       DateTime? @map("reviewedAt") @ignore
  /// Legacy Phase 4 compatibility column. Retained to preserve additive migration history.
  /// Must remain null for Phase 13 withdrawals; not used by the active withdrawal or payout-destination architecture.
  legacyPaidAt           DateTime? @map("paidAt") @ignore

  wallet               Wallet                         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  sourceAccount        LedgerAccount                  @relation("WithdrawalSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  heldAccount          LedgerAccount                  @relation("WithdrawalHeldAccount", fields: [heldAccountId], references: [id], onDelete: Restrict)
  payoutDestination    PayoutDestination              @relation(fields: [payoutDestinationId], references: [id], onDelete: Restrict)
  reserveLedgerJournal LedgerJournal                  @relation("WithdrawalReserveLedgerJournal", fields: [reserveLedgerJournalId], references: [id], onDelete: Restrict)
  releaseLedgerJournal LedgerJournal?                 @relation("WithdrawalReleaseLedgerJournal", fields: [releaseLedgerJournalId], references: [id], onDelete: Restrict)
  payoutLedgerJournal  LedgerJournal?                 @relation("WithdrawalPayoutLedgerJournal", fields: [payoutLedgerJournalId], references: [id], onDelete: Restrict)
  currentPayoutAttempt WithdrawalPayoutAttempt?       @relation("WithdrawalCurrentPayoutAttempt", fields: [currentPayoutAttemptId], references: [id], onDelete: Restrict)
  requestedBy          User                           @relation("WithdrawalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy           User?                          @relation("WithdrawalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  rejectedBy           User?                          @relation("WithdrawalRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  cancelledBy          User?                          @relation("WithdrawalCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  completedBy          User?                          @relation("WithdrawalCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  payoutAttempts       WithdrawalPayoutAttempt[]      @relation("WithdrawalPayoutAttempts")
  statusHistory        WithdrawalStatusHistory[]
  reconciliationCases  WithdrawalReconciliationCase[]

  @@index([walletId])
  @@index([ownerType, ownerId])
  @@index([status, createdAt])
  @@index([payoutDestinationId])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([reconciliationRequiredAt])
  @@index([createdAt], map: "WithdrawalRequest_requestedAt_idx")
  @@index([legacyReviewedByUserId], map: "WithdrawalRequest_reviewedByUserId_idx")
  @@index([status], map: "WithdrawalRequest_status_idx")
}

