model MarketplaceCartLineModifier {
  id                            String   @id @default(cuid())
  cartLineId                    String
  modifierGroupPublicReference  String
  modifierOptionPublicReference String
  quantity                      Int      @default(1)
  observedPriceDelta            Decimal  @db.Decimal(18, 2)
  createdAt                     DateTime @default(now())

  cartLine MarketplaceCartLine @relation(fields: [cartLineId], references: [id], onDelete: Restrict, map: "MarketplaceCartLineModifier_line_fkey")

  @@unique([cartLineId, modifierGroupPublicReference, modifierOptionPublicReference], map: "MarketplaceCartLineModifier_line_group_option_key")
