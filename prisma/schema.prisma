  driver                DriverProfile                     @relation(fields: [driverId], references: [id], onDelete: Restrict, map: "DriverEarning_driver_fkey")
  wallet                Wallet                            @relation(fields: [walletId], references: [id], onDelete: Restrict, map: "DriverEarning_wallet_fkey")
  payableAccount        LedgerAccount                     @relation("DriverEarningPayableAccount", fields: [payableAccountId], references: [id], onDelete: Restrict, map: "DriverEarning_payableAccount_fkey")
  assignment            OrderAssignment                   @relation(fields: [assignmentId], references: [id], onDelete: Restrict, map: "DriverEarning_assignment_fkey")
  order                 Order                             @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "DriverEarning_order_fkey")
  payment               Payment                           @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "DriverEarning_payment_fkey")
