model MarketplaceStoreOrder {
  id                         String                              @id @default(cuid())
  publicReference            String                              @unique
  marketplaceOrderId         String
  checkoutStoreGroupId       String                              @unique
  storeId                    String
  status                     MarketplaceStoreOrderStatus         @default(PENDING_SETTLEMENT)
  currency                   LedgerCurrency                      @default(ZAR)
  merchandiseSubtotal        Decimal                             @db.Decimal(18, 2)
  modifierSubtotal           Decimal                             @db.Decimal(18, 2)
  deliveryFee                Decimal                             @db.Decimal(18, 2)
  groupTotal                 Decimal                             @db.Decimal(18, 2)
  sellerIdentityEvidence     Json?
  taxEvidence                Json?
  termsReference             String?
  refundPolicyReference      String?
  // Phase 21 keeps Phase 20 commercial/settlement status intact. These
  // orthogonal operational dimensions are the only mutable fulfilment state.
  operationalPolicyId        String?
  operationalPolicyReference String?
  operationalPolicyVersion   Int?
  acceptanceStatus           StoreOrderAcceptanceStatus          @default(PENDING_STORE_REVIEW)
  preparationStatus          StoreOrderPreparationStatus         @default(NOT_STARTED)
  resolutionStatus           StoreOrderResolutionStatus          @default(CLEAR)
  deliveryBridgeStatus       StoreOrderDeliveryBridgeStatus      @default(NOT_REQUESTED)
  financialResolutionStatus  StoreOrderFinancialResolutionStatus @default(UNCHANGED)
  derivedStatus              StoreOrderDerivedStatus             @default(AWAITING_STORE_REVIEW)
  reviewDeadlineAt           DateTime?
