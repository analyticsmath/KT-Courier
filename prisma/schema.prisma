  settlementSnapshots MarketplaceSettlementSnapshot[]               @relation("MarketplaceSettlementEvidenceSource")

  @@unique([checkoutStoreGroupId, reviewVersion], map: "MarketplaceCheckoutStoreSettlementEvidence_group_review_key")
  @@index([checkoutId, reviewVersion], map: "MarketplaceCheckoutStoreSettlementEvidence_checkoutId_reviewVer")
