  @@index([assignmentId, createdAt], map: "DriverEarning_assignment_createdAt_idx")
  @@index([orderId, createdAt], map: "DriverEarning_order_createdAt_idx")
  @@index([paymentId, createdAt], map: "DriverEarning_payment_createdAt_idx")
  @@index([subjectPublicReference, createdAt], map: "DriverEarning_subjectReference_createdAt_idx")
  @@index([releaseEligibleAt, status])
