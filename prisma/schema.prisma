  fullName    String
  email       String
  phone       String?
  notes       String?
  metadata    Json?
  submittedAt DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  vacancy   Vacancy                    @relation(fields: [vacancyId], references: [id], onDelete: Cascade, map: "RecruitmentApplication_vacancyId_fkey")
  user      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull, map: "RecruitmentApplication_userId_fkey")
  documents ApplicationDocument[]
  history   ApplicationStatusHistory[]

  @@index([vacancyId], map: "RecruitmentApplication_vacancyId_idx")
  @@index([userId], map: "RecruitmentApplication_userId_idx")
  @@index([status], map: "RecruitmentApplication_status_idx")
  @@index([email], map: "RecruitmentApplication_email_idx")
  @@index([submittedAt], map: "RecruitmentApplication_submittedAt_idx")
