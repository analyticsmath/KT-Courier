enum ReportAudience {
  CUSTOMER
  STORE
  DRIVER
  PROMOTER
  RECRUITMENT
  DEVELOPER
  ADMINISTRATOR
}

enum ReportJobStatus {
  REQUESTED
  QUEUED
  RUNNING
  COMPLETED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED
  EXPIRED
}

enum ReportExecutionMode {
  SYNCHRONOUS_SUMMARY
  ASYNCHRONOUS_REPORT
  ASYNCHRONOUS_EXPORT
}

enum ReportExportFormat {
  CSV
  JSON
  XLSX
}

enum ReportReconciliationReason {
  REPORT_JOB_WITHOUT_DEFINITION
  REPORT_JOB_WITH_INVALID_FILTER_HASH
  REPORT_JOB_STUCK_RUNNING
  REPORT_JOB_WITHOUT_ARTIFACT
  REPORT_ARTIFACT_WITHOUT_JOB
  REPORT_ARTIFACT_CHECKSUM_MISMATCH
  REPORT_ARTIFACT_EXPIRED_BUT_AVAILABLE
  REPORT_PERMISSION_SNAPSHOT_MISMATCH
  REPORT_OWNER_SCOPE_MISMATCH
  REPORT_ROW_LIMIT_EXCEEDED
  REPORT_STORAGE_FAILURE
  REPORT_DOWNLOAD_AUDIT_MISSING
  REPORT_DUPLICATE_EXECUTION
}

enum ReportReconciliationStatus {
  OPEN
  IN_PROGRESS
  CONVERGED
}

model ReportDefinition {
  id                   String         @id @default(cuid())
  publicReference      String         @unique
  key                  String         @unique
  name                 String
  description          String
  audience             ReportAudience
  requiredPermission   String
  resourceOwnerRule    String
  allowedFormats       Json
  allowedFilters       Json
  maximumDateRangeDays Int?
  maximumRowCount      Int            @default(10000)
  defaultOrdering      Json?
  sensitivity          String         @default("MEDIUM")
  retentionDays        Int            @default(30)
  piiPolicy            String         @default("MINIMIZED")
  currencyPolicy       String         @default("ZAR_EXACT")
  timezonePolicy       String         @default("UTC")
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([audience, active])
}

model ReportDefinitionVersion {
