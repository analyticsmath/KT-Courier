  currency          String                @default("ZAR")
  priceIncludesTax  Boolean               @default(true)
  unitPriceAmount   Decimal?              @db.Decimal(18, 2)
  unitPriceUnit     String?
  unitPriceQuantity Decimal?              @db.Decimal(18, 4)
