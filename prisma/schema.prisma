  expiresAt             DateTime
  createdAt             DateTime                       @default(now())

  customerUser           User?                         @relation("SubscriptionReviewSubject", fields: [customerUserId], references: [id], onDelete: Restrict, map: "SubscriptionReview_customer_fkey")
  store                  Store?                        @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "SubscriptionReview_store_fkey")
  acknowledgements       SubscriptionAcknowledgement[]
  SubscriptionContract   SubscriptionContract?         @relation(fields: [subscriptionContractId], references: [id], onDelete: Restrict, map: "SubscriptionReview_contract_fkey")
  subscriptionContractId String?

  @@unique([payerUserId, publicReference], map: "SubscriptionReview_payer_reference_key")
  @@index([programId, planVersionId, status])
  @@index([customerUserId, status])
  @@index([storeId, status])
}

model SubscriptionAcknowledgement {
  id                    String   @id @default(cuid())
  publicReference       String   @unique
  reviewId              String
  contractId            String?
  actorUserId           String
  reviewVersion         Int
  commercialFingerprint String
  serviceStartConsent   Boolean  @default(false)
  acknowledgedAt        DateTime @default(now())
  createdAt             DateTime @default(now())

  review    SubscriptionReview    @relation(fields: [reviewId], references: [id], onDelete: Restrict, map: "SubscriptionAcknowledgement_review_fkey")
  contract  SubscriptionContract? @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionAcknowledgement_contract_fkey")
  actorUser User                  @relation("SubscriptionAcknowledgementActor", fields: [actorUserId], references: [id], onDelete: Restrict, map: "SubscriptionAcknowledgement_actor_fkey")

  @@unique([reviewId, reviewVersion], map: "SubscriptionAcknowledgement_review_version_key")
  @@index([contractId])
}

model SubscriptionPaymentAuthority {
  id                              String                             @id @default(cuid())
  publicReference                 String                             @unique
  contractId                      String                             @unique
  provider                        PaymentProvider
  mode                            SubscriptionPaymentAuthorityMode
  providerCustomerReference       String?
  providerSubscriptionReference   String?                            @unique
  providerTokenReferenceEncrypted String?
  providerTokenFingerprint        String?                            @unique
  providerTokenRotatedAt          DateTime?
  status                          SubscriptionPaymentAuthorityStatus @default(PENDING)
  authorisedAt                    DateTime?
  pausedAt                        DateTime?
  cancelledAt                     DateTime?
  lastSynchronizedAt              DateTime?
  version                         Int                                @default(0)
  createdAt                       DateTime                           @default(now())
  updatedAt                       DateTime                           @updatedAt

  contract                SubscriptionContract                          @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionPaymentAuthority_contract_fkey")
  reconciliationCases     SubscriptionReconciliationCase[]
  synchronizationEvidence SubscriptionProviderSynchronizationEvidence[]

  @@unique([provider, providerCustomerReference, providerSubscriptionReference], map: "SubscriptionPaymentAuthority_provider_refs_key")
  @@index([provider, status])
}

model SubscriptionBillingCycle {
  id              String                         @id @default(cuid())
  publicReference String                         @unique
  contractId      String
  cycleNumber     Int
  periodStart     DateTime
  periodEnd       DateTime
  billingDate     DateTime
  status          SubscriptionBillingCycleStatus @default(SCHEDULED)
  currency        String                         @default("ZAR")
  amountDue       Decimal                        @db.Decimal(18, 2)
  amountPaid      Decimal                        @default(0) @db.Decimal(18, 2)
  createdAt       DateTime                       @default(now())
  paidAt          DateTime?
  failedAt        DateTime?
  completedAt     DateTime?

  contract            SubscriptionContract                    @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionBillingCycle_contract_fkey")
  invoice             SubscriptionInvoice?
  entitlementGrants   SubscriptionEntitlementGrant[]
  renewalJob          SubscriptionRenewalJob?
  reconciliationCases SubscriptionReconciliationCase[]
  settlement          SubscriptionInvoiceSettlement?
  revenueSchedule     SubscriptionRevenueRecognitionSchedule?
  refundAdjustments   SubscriptionRefundAdjustment[]

  @@unique([contractId, cycleNumber], map: "SubscriptionBillingCycle_contract_cycle_key")
  @@unique([contractId, periodStart, periodEnd], map: "SubscriptionBillingCycle_contract_period_key")
  @@index([status, billingDate])
}

model SubscriptionInvoice {
  id                   String                    @id @default(cuid())
  publicReference      String                    @unique
  contractId           String
  billingCycleId       String                    @unique
  payerUserId          String
  invoiceNumber        String                    @unique
  status               SubscriptionInvoiceStatus @default(ISSUED)
  currency             String                    @default("ZAR")
  subtotal             Decimal                   @db.Decimal(18, 2)
  taxAmount            Decimal                   @default(0) @db.Decimal(18, 2)
  total                Decimal                   @db.Decimal(18, 2)
  planSnapshot         Json
  benefitSnapshot      Json
  supplierSnapshot     Json
  legalDocumentVersion String
  issuedAt             DateTime                  @default(now())
  dueAt                DateTime
  paidAt               DateTime?
  voidedAt             DateTime?
  createdAt            DateTime                  @default(now())

  contract            SubscriptionContract                    @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionInvoice_contract_fkey")
  billingCycle        SubscriptionBillingCycle                @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionInvoice_cycle_fkey")
  payerUser           User                                    @relation("SubscriptionInvoicePayer", fields: [payerUserId], references: [id], onDelete: Restrict, map: "SubscriptionInvoice_payer_fkey")
  payment             Payment?                                @relation("SubscriptionInvoicePayment")
  reconciliationCases SubscriptionReconciliationCase[]
  settlement          SubscriptionInvoiceSettlement?
  revenueSchedule     SubscriptionRevenueRecognitionSchedule?
  refundAdjustments   SubscriptionRefundAdjustment[]

  SubscriptionRenewalApplication SubscriptionRenewalApplication?

  @@index([contractId, issuedAt])
  @@index([payerUserId, createdAt])
  @@index([status, dueAt])
}

enum SubscriptionInvoiceSettlementStatus {
  SETTLED
  RECONCILIATION_REQUIRED
  REVERSED
}

enum SubscriptionRevenueRecognitionScheduleStatus {
  ACTIVE
  COMPLETED
  REVERSED
  RECONCILIATION_REQUIRED
}

/// One immutable financial reclassification for an exact paid subscription
/// invoice. The Phase 12 receipt remains the source of customer-held funds.
model SubscriptionInvoiceSettlement {
  id              String                              @id @default(cuid())
  publicReference String                              @unique
  invoiceId       String                              @unique
  billingCycleId  String                              @unique
  paymentId       String                              @unique
  status          SubscriptionInvoiceSettlementStatus @default(SETTLED)
  currency        String                              @default("ZAR")
  settledAmount   Decimal                             @db.Decimal(18, 2)
  taxAmount       Decimal                             @default(0) @db.Decimal(18, 2)
  netAmount       Decimal                             @db.Decimal(18, 2)
  ledgerJournalId String                              @unique
  operationId     String                              @unique
  safeEvidence    Json
  settledAt       DateTime                            @default(now())
  createdAt       DateTime                            @default(now())

  invoice       SubscriptionInvoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "SubscriptionInvoiceSettlement_invoice_fkey")
  billingCycle  SubscriptionBillingCycle @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionInvoiceSettlement_cycle_fkey")
  payment       Payment                  @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "SubscriptionInvoiceSettlement_payment_fkey")
  ledgerJournal LedgerJournal            @relation("SubscriptionSettlementJournal", fields: [ledgerJournalId], references: [id], onDelete: Restrict, map: "SubscriptionInvoiceSettlement_journal_fkey")

  /// Straight-line daily service schedule. `recognizedAmount` is cumulative and
  /// entries are append-only daily deltas, which prevents rounding drift.

  @@index([status, settledAt])
}

model SubscriptionRevenueRecognitionSchedule {
  id               String                                       @id @default(cuid())
  publicReference  String                                       @unique
  invoiceId        String                                       @unique
  billingCycleId   String                                       @unique
  currency         String                                       @default("ZAR")
  netAmount        Decimal                                      @db.Decimal(18, 2)
  recognizedAmount Decimal                                      @default(0) @db.Decimal(18, 2)
  serviceStart     DateTime
  serviceEnd       DateTime
  status           SubscriptionRevenueRecognitionScheduleStatus @default(ACTIVE)
  policyVersion    String
  createdAt        DateTime                                     @default(now())
  updatedAt        DateTime                                     @updatedAt

  invoice      SubscriptionInvoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "SubscriptionRevenueRecognitionSchedule_invoice_fkey")
  billingCycle SubscriptionBillingCycle              @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionRevenueRecognitionSchedule_cycle_fkey")
  entries      SubscriptionRevenueRecognitionEntry[]

  @@index([status, serviceEnd])
}

model SubscriptionRevenueRecognitionEntry {
  id               String   @id @default(cuid())
  publicReference  String   @unique
  scheduleId       String
  recognitionDate  DateTime
  amount           Decimal  @db.Decimal(18, 2)
  cumulativeAmount Decimal  @db.Decimal(18, 2)
  ledgerJournalId  String   @unique
  operationId      String   @unique
  safeEvidence     Json
  createdAt        DateTime @default(now())

  schedule      SubscriptionRevenueRecognitionSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict, map: "SubscriptionRevenueRecognitionEntry_schedule_fkey")
  ledgerJournal LedgerJournal                          @relation("SubscriptionRevenueRecognitionJournal", fields: [ledgerJournalId], references: [id], onDelete: Restrict, map: "SubscriptionRevenueRecognitionEntry_journal_fkey")

  @@unique([scheduleId, recognitionDate], map: "SubscriptionRevenueRecognitionEntry_scheduleId_recognitionDate_")
  @@index([scheduleId, recognitionDate], map: "SubscriptionRevenueRecognitionEntry_schedule_recognitionDate_id")
}

model SubscriptionRenewalJob {
  id                   String                       @id @default(cuid())
  publicReference      String                       @unique
  contractId           String
  billingCycleId       String                       @unique
  status               SubscriptionRenewalJobStatus @default(PENDING)
  operationId          String                       @unique
  requestHash          String
  attemptCount         Int                          @default(0)
  nextAttemptAt        DateTime
  lastSafeError        String?
  completedAt          DateTime?
  reconciliationCaseId String?                      @unique
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  contract           SubscriptionContract            @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionRenewalJob_contract_fkey")
  billingCycle       SubscriptionBillingCycle        @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionRenewalJob_cycle_fkey")
  reconciliationCase SubscriptionReconciliationCase? @relation("SubscriptionRenewalReconciliation", fields: [reconciliationCaseId], references: [id], onDelete: Restrict, map: "SubscriptionRenewalJob_reconciliation_fkey")

  @@index([status, nextAttemptAt])
  @@index([contractId, status])
}

model SubscriptionEntitlementGrant {
  id                  String                             @id @default(cuid())
  publicReference     String                             @unique
  contractId          String
  billingCycleId      String
  benefitDefinitionId String
  subjectType         SubscriptionProgramSubjectType
  customerUserId      String?
  storeId             String?
  status              SubscriptionEntitlementGrantStatus @default(SCHEDULED)
  valueType           SubscriptionBenefitValueType
  originalAmount      Decimal?                           @db.Decimal(18, 2)
  remainingAmount     Decimal?                           @db.Decimal(18, 2)
  originalQuantity    Int?
  remainingQuantity   Int?
  effectiveFrom       DateTime
  effectiveUntil      DateTime
  sourceVersion       String
  createdAt           DateTime                           @default(now())
  exhaustedAt         DateTime?
  revokedAt           DateTime?

  contract            SubscriptionContract                      @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementGrant_contract_fkey")
  billingCycle        SubscriptionBillingCycle                  @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementGrant_cycle_fkey")
  benefitDefinition   SubscriptionBenefitDefinition             @relation(fields: [benefitDefinitionId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementGrant_benefit_fkey")
  customerUser        User?                                     @relation(fields: [customerUserId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementGrant_customer_fkey")
  store               Store?                                    @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementGrant_store_fkey")
  usages              SubscriptionEntitlementUsage[]
  reconciliationCases SubscriptionReconciliationCase[]
  refundAdjustments   SubscriptionEntitlementRefundAdjustment[]

  @@unique([billingCycleId, benefitDefinitionId], map: "SubscriptionEntitlementGrant_cycle_benefit_key")
  @@index([customerUserId, status, effectiveUntil], map: "SubscriptionEntitlementGrant_customer_status_effectiveUntil_idx")
  @@index([storeId, status, effectiveUntil], map: "SubscriptionEntitlementGrant_store_status_effectiveUntil_idx")
}

model SubscriptionEntitlementUsage {
  id              String                                 @id @default(cuid())
  publicReference String                                 @unique
  grantId         String
  operationId     String
  requestHash     String
  action          SubscriptionEntitlementUsageAction
  amount          Decimal?                               @db.Decimal(18, 2)
  quantity        Int?
  sourceType      SubscriptionEntitlementUsageSourceType
  sourceReference String
  createdAt       DateTime                               @default(now())

  grant SubscriptionEntitlementGrant @relation(fields: [grantId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementUsage_grant_fkey")

  @@unique([grantId, operationId, action], map: "SubscriptionEntitlementUsage_grant_operation_action_key")
  @@index([grantId, createdAt])
  @@index([sourceType, sourceReference])
}

model SubscriptionContractChange {
  id                     String                           @id @default(cuid())
  publicReference        String                           @unique
  contractId             String
  changeType             SubscriptionContractChangeType
  status                 SubscriptionContractChangeStatus @default(DRAFT)
  sourceContractVersion  Int
  targetPlanVersionId    String?
  effectiveAt            DateTime
  commercialFingerprint  String
  customerAcknowledgedAt DateTime?
  appliedAt              DateTime?
  cancelledAt            DateTime?
  operationId            String
  requestHash            String
  createdAt              DateTime                         @default(now())

  contract          SubscriptionContract     @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionContractChange_contract_fkey")
  targetPlanVersion SubscriptionPlanVersion? @relation(fields: [targetPlanVersionId], references: [id], onDelete: Restrict, map: "SubscriptionContractChange_plan_fkey")

  @@unique([contractId, operationId], map: "SubscriptionContractChange_contract_operation_key")
  @@index([contractId, status, effectiveAt])
}

model SubscriptionReconciliationCase {
  id                  String                               @id @default(cuid())
  publicReference     String                               @unique
  caseKey             String                               @unique
  contractId          String?
  billingCycleId      String?
  invoiceId           String?
  paymentId           String?
  entitlementGrantId  String?
  providerAuthorityId String?
  reason              SubscriptionReconciliationReason
  status              SubscriptionReconciliationCaseStatus @default(OPEN)
  priority            SubscriptionReconciliationPriority   @default(MEDIUM)
  safeSummary         String
  safeEvidence        Json?
  openedAt            DateTime                             @default(now())
  lastObservedAt      DateTime                             @default(now())
  resolvedAt          DateTime?
  resolutionCode      String?
  createdAt           DateTime                             @default(now())
  updatedAt           DateTime                             @updatedAt

  contract          SubscriptionContract?         @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_contract_fkey")
  billingCycle      SubscriptionBillingCycle?     @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_cycle_fkey")
  invoice           SubscriptionInvoice?          @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_invoice_fkey")
  payment           Payment?                      @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_payment_fkey")
  entitlementGrant  SubscriptionEntitlementGrant? @relation(fields: [entitlementGrantId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_grant_fkey")
  providerAuthority SubscriptionPaymentAuthority? @relation(fields: [providerAuthorityId], references: [id], onDelete: Restrict, map: "SubscriptionReconciliationCase_authority_fkey")
  renewalJob        SubscriptionRenewalJob?       @relation("SubscriptionRenewalReconciliation")

  @@index([status, priority, lastObservedAt], map: "SubscriptionReconciliationCase_status_priority_lastObservedAt_i")
  @@index([contractId, status])
  @@index([paymentId, status])
}

model SubscriptionEventIntent {
  id              String                      @id @default(cuid())
  publicReference String                      @unique
  contractId      String
  type            SubscriptionEventIntentType
  operationId     String
  safePayload     Json?
  publishedAt     DateTime?
  createdAt       DateTime                    @default(now())

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionEventIntent_contract_fkey")

  /// Durable replay receipt shared by admin recovery and bounded processors.

  @@unique([contractId, type, operationId], map: "SubscriptionEventIntent_contract_type_operation_key")
  @@index([publishedAt, createdAt])
}

model SubscriptionOperationReceipt {
  id              String    @id @default(cuid())
  publicReference String    @unique
  contractId      String
  operationId     String    @unique
  operationType   String
  requestHash     String
  outcome         String
  safeEvidence    Json?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contract SubscriptionContract @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionOperationReceipt_contract_fkey")

  /// Safe status observations only. It contains neither an encrypted token nor a raw provider payload.

  @@index([contractId, operationType, createdAt], map: "SubscriptionOperationReceipt_contract_operation_created_idx")
}

model SubscriptionProviderSynchronizationEvidence {
  id                  String   @id @default(cuid())
  publicReference     String   @unique
  contractId          String
  providerAuthorityId String
  operationId         String   @unique
  observedStatus      String
  internalStatus      String
  safeEvidence        Json
  observedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  contract          SubscriptionContract         @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionProviderSynchronizationEvidence_contract_fkey")
  providerAuthority SubscriptionPaymentAuthority @relation(fields: [providerAuthorityId], references: [id], onDelete: Restrict, map: "SubscriptionProviderSynchronizationEvidence_authority_fkey")

  /// Links the Phase 15 refund request to the subscription financial reversal.

  @@index([providerAuthorityId, observedAt], map: "SubscriptionProviderSynchronizationEvidence_authority_observed_")
}

model SubscriptionRefundAdjustment {
  id               String         @id @default(cuid())
  publicReference  String         @unique
  contractId       String
  invoiceId        String
  billingCycleId   String
  refundId         String
  operationId      String         @unique
  deferredAmount   Decimal        @db.Decimal(18, 2)
  recognizedAmount Decimal        @db.Decimal(18, 2)
  taxAmount        Decimal        @default(0) @db.Decimal(18, 2)
  ledgerJournalId  String?        @unique(map: "SubscriptionRefundAdjustment_journal_key")
  ledgerJournal    LedgerJournal? @relation(fields: [ledgerJournalId], references: [id], onDelete: Restrict, map: "SubscriptionRefundAdjustment_journal_fkey")
  safeEvidence     Json
  createdAt        DateTime       @default(now())

  contract               SubscriptionContract                      @relation(fields: [contractId], references: [id], onDelete: Restrict, map: "SubscriptionRefundAdjustment_contract_fkey")
  invoice                SubscriptionInvoice                       @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "SubscriptionRefundAdjustment_invoice_fkey")
  billingCycle           SubscriptionBillingCycle                  @relation(fields: [billingCycleId], references: [id], onDelete: Restrict, map: "SubscriptionRefundAdjustment_cycle_fkey")
  refund                 PaymentRefund                             @relation(fields: [refundId], references: [id], onDelete: Restrict, map: "SubscriptionRefundAdjustment_refund_fkey")
  entitlementAdjustments SubscriptionEntitlementRefundAdjustment[]

  /// Per-grant evidence that preserves usage while linking a refund adjustment.

  @@unique([invoiceId, refundId], map: "SubscriptionRefundAdjustment_invoice_refund_key")
  @@index([contractId, createdAt], map: "SubscriptionRefundAdjustment_contract_created_idx")
}

model SubscriptionEntitlementRefundAdjustment {
  id                 String   @id @default(cuid())
  publicReference    String   @unique
  refundAdjustmentId String
  grantId            String
  operationId        String
  action             String
  safeEvidence       Json?
  createdAt          DateTime @default(now())

  refundAdjustment SubscriptionRefundAdjustment @relation(fields: [refundAdjustmentId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementRefundAdjustment_refund_adjustment_fkey")
  grant            SubscriptionEntitlementGrant @relation(fields: [grantId], references: [id], onDelete: Restrict, map: "SubscriptionEntitlementRefundAdjustment_grant_fkey")

  /// Exactly one Phase 12 application record for an invoice Payment; retries
  /// converge on this evidence instead of duplicating grants or schedules.

  @@unique([refundAdjustmentId, grantId, operationId], map: "SubscriptionEntitlementRefundAdjustment_refund_grant_operation_")
  @@index([grantId, createdAt], map: "SubscriptionEntitlementRefundAdjustment_grant_created_idx")
}

model SubscriptionRenewalApplication {
  id              String              @id @default(cuid())
  publicReference String              @unique
  invoiceId       String              @unique
  paymentId       String              @unique
  operationId     String              @unique
  classification  String
  safeEvidence    Json
  appliedAt       DateTime            @default(now())
  invoice         SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict, map: "SubscriptionRenewalApplication_invoice_fkey")
  payment         Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "SubscriptionRenewalApplication_payment_fkey")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  ARCHIVED
}

enum InventoryChangeType {
  INITIAL
  ADJUSTMENT
  SALE
  RESTOCK
  RETURN
  RESERVATION
  RELEASE
}

model ProductCategory {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("ProductCategoryTree")
  products Product[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id             String        @id @default(cuid())
  storeId        String
  categoryId     String?
  name           String
  slug           String
  description    String?
  sku            String?
  status         ProductStatus @default(DRAFT)
  price          Decimal       @db.Decimal(12, 2)
  currency       String        @default("ZAR")
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  imagesCount    Int           @default(0)
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  store                       Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category                    ProductCategory?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                      ProductImage[]
  inventory                   InventoryItem?
  cartItems                   CartItem[]
  orderItems                  OrderItem[]
  adCampaigns                 AdCampaign[]
  advertisingCampaignVersions AdvertisingCampaignVersion[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sortOrder])
}

model InventoryItem {
  id                String   @id @default(cuid())
  productId         String   @unique
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  lowStockThreshold Int?
  trackInventory    Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([quantityOnHand])
}

model InventoryMovement {
  id              String              @id @default(cuid())
  inventoryItemId String
  type            InventoryChangeType
  quantityChange  Int
  reason          String?
  referenceType   String?
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime            @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdByUserId])
  @@index([createdAt])
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  storeId   String?
  status    CartStatus @default(ACTIVE)
  currency  String     @default("ZAR")
  metadata  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store?     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
  @@index([storeId])
  @@index([status])
  @@index([createdAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  currency  String   @default("ZAR")
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
