# Placeholder-only Docker Compose settings.
# Do not put real production secrets in this file.

POSTGRES_DB=kt_courier_dev
POSTGRES_USER=kt_courier
POSTGRES_PASSWORD=replace_with_local_only_password
SHADOW_POSTGRES_DB=kt_courier_shadow
POSTGRES_PORT=5433
APP_PORT=3000

# Host tools use localhost and the published development port.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_shadow?schema=public"

# Containers use the Compose service hostname and internal port.
CONTAINER_DATABASE_URL="postgresql://USER:PASSWORD@db:5432/kt_courier_dev?schema=public"
CONTAINER_SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@db:5432/kt_courier_shadow?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
TRUSTED_PROXY_MODE="direct"

PAYFAST_MODE="disabled"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_CREDENTIAL_VERSION=""
PAYMENT_PROXY_MODE="direct"
PAYMENT_APP_ORIGIN="https://replace-with-public-origin.example.invalid/"

EMAIL_PROVIDER="console"
EMAIL_FROM="KT Couriers <noreply@example.invalid>"
EMAIL_REPLY_TO="support@example.invalid"
RESEND_API_KEY="replace-with-provider-key"

REDIS_URL="redis://redis:6379/0"
CHECKOUT_PUBLIC_ENABLED="false"
REPORT_ARTIFACT_STORAGE="local"
REPORT_ARTIFACT_DIR="artifacts/reports"
PRIVATE_MEDIA_STORAGE="local"
CATALOG_MEDIA_STORAGE="local"

NEXT_PUBLIC_TURNSTILE_SITE_KEY="replace-with-turnstile-site-key"
TURNSTILE_SECRET_KEY="replace-with-turnstile-secret-key"
CRON_SECRET="replace-with-at-least-32-character-server-secret"

READINESS_INTERNAL_AUTH_SECRET="replace-with-at-least-32-character-server-secret"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-server-actions-key"
DEPLOYMENT_VERSION="development-placeholder"
