# Placeholder-only host development settings.
# Copy values into an untracked local env file and replace every placeholder.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_shadow?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# South African Payfast custom checkout. Create a dedicated Payfast sandbox
# account; never commit shared, production, or real credential values.
PAYFAST_MODE="disabled"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_CREDENTIAL_VERSION=""
# direct fails closed in the current Next.js route runtime because no peer IP is exposed.
# single_trusted_proxy requires an isolated proxy that replaces x-kt-source-ip.
PAYMENT_PROXY_MODE="direct"
PAYMENT_APP_ORIGIN="https://replace-with-public-origin.example.invalid/"
EMAIL_PROVIDER="console"
EMAIL_FROM="KT Couriers <noreply@example.invalid>"
EMAIL_REPLY_TO="support@example.invalid"
RESEND_API_KEY="replace-with-provider-key"
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="replace-with-public-browser-key"
GOOGLE_MAPS_SERVER_KEY="replace-with-server-key"
DEVELOPER_API_CREDENTIAL_HMAC_KEY="replace-with-at-least-32-character-server-secret"
DEVELOPER_API_CURSOR_HMAC_KEY="replace-with-at-least-32-character-server-secret"
DEVELOPER_WEBHOOK_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
DEVELOPER_API_ENDPOINT_ENVIRONMENT="TEST"
