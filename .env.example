# Placeholder-only host development settings.
# Copy values into an untracked local env file and replace every placeholder.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/kt_courier_shadow?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# South African Payfast custom checkout. Create a dedicated Payfast sandbox
# account; never commit shared, production, or real credential values.
PAYFAST_MODE="disabled"
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PAYFAST_CREDENTIAL_VERSION=""
# direct fails closed in the current Next.js route runtime because no peer IP is exposed.
# single_trusted_proxy requires an isolated proxy that replaces x-kt-source-ip.
PAYMENT_PROXY_MODE="direct"
PAYMENT_APP_ORIGIN="https://replace-with-public-origin.example.invalid/"
EMAIL_PROVIDER="console"
EMAIL_FROM="KT Couriers <noreply@example.invalid>"
EMAIL_REPLY_TO="support@example.invalid"
RESEND_API_KEY="replace-with-provider-key"
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="replace-with-public-browser-key"
GOOGLE_MAPS_SERVER_KEY="replace-with-server-key"
DEVELOPER_API_CREDENTIAL_HMAC_KEY="replace-with-at-least-32-character-server-secret"
DEVELOPER_API_CURSOR_HMAC_KEY="replace-with-at-least-32-character-server-secret"
DEVELOPER_WEBHOOK_ENCRYPTION_KEY="replace-with-32-byte-base64-key"
DEVELOPER_API_ENDPOINT_ENVIRONMENT="TEST"

# Phase 5 operational configuration. Values below are placeholders only.
# REDIS_URL is required for production readiness because authentication and other
# distributed-required rate limits fail closed without a shared backend.
REDIS_URL="redis://replace-with-shared-rate-limit-store.example.invalid:6379/0"
# Keep public checkout disabled until the live payment configuration and final
# consolidated validation have been explicitly approved.
CHECKOUT_PUBLIC_ENABLED="false"
# Local secure artifact storage is suitable only for development. Production must
# provide a durable provider behind the same reporting storage authority.
REPORT_ARTIFACT_STORAGE="local"
REPORT_ARTIFACT_DIR="artifacts/reports"
# P0 KYC/compliance evidence. Local mode is development-only and is never
# selected in production; credentials are used only by the server-side adapter.
PRIVATE_MEDIA_STORAGE="local"
PRIVATE_MEDIA_LOCAL_DIR="var/private-media"
PRIVATE_MEDIA_S3_ENDPOINT="https://replace-with-private-object-storage.example.invalid"
PRIVATE_MEDIA_S3_BUCKET="replace-with-private-bucket"
PRIVATE_MEDIA_S3_REGION="replace-with-region"
PRIVATE_MEDIA_S3_ACCESS_KEY_ID="replace-with-access-key"
PRIVATE_MEDIA_S3_SECRET_ACCESS_KEY="replace-with-secret"
# Optional internal diagnostics authentication; administrators additionally need
# the exact system_readiness.read permission. Never expose this value to clients.
READINESS_INTERNAL_AUTH_SECRET="replace-with-at-least-32-character-server-secret"
# Required for multi-instance Next.js deployments. Base64 AES key (16, 24, or 32 bytes).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="replace-with-base64-server-actions-key"
# Non-secret deployment identity for rolling-deployment version-skew protection.
DEPLOYMENT_VERSION="development-placeholder"
# Optional observability/export configuration. Telemetry is disabled safely when absent.
SENTRY_DSN="replace-with-error-monitoring-dsn"
NEXT_PUBLIC_ANALYTICS_KEY="replace-with-public-analytics-key"
