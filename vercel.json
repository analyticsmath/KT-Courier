{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"KT Couriers: no dependency install required for the Vercel edge proxy\"",
  "buildCommand": "node -e \"const fs=require('fs');fs.mkdirSync('vercel-proxy-output',{recursive:true});fs.writeFileSync('vercel-proxy-output/health.txt','KT Couriers Vercel edge proxy');\"",
  "outputDirectory": "vercel-proxy-output",
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://web-production-9f8bb.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
