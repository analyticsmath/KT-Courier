{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "integration/codex-phase1-phase2-2026-10-11": false
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "https://web-production-9f8bb.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "alias": [
    "ktcouriers.com",
    "www.ktcouriers.com"
  ]
}
