route_report.json
components_report.json
discovery_files.txt
gen_report.js

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.claude

# generated Playwright output
/output/
