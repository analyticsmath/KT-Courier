# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
.devserver.err.log
.devserver.out.log

# test and analysis output
/test-results
/coverage
/artifacts

# Version-controlled Phase A/B governance authority.  Keep all other artifact
# output ignored: only these current, human-audited source-of-truth records may
# be selected by the human Git workflow.
!/artifacts/
/artifacts/*
!/artifacts/phase-a-normalized-engineering-requirements.json
!/artifacts/phase-a-normalized-capability-map.json
!/artifacts/phase-a-normalization-coverage.json
!/artifacts/phase-a-client-source-traceability.json
!/artifacts/phase-b-implementation-ledger.json
!/artifacts/phase-b-requirement-closure.json
!/artifacts/phase-c-functional-frontend-ledger.json
!/artifacts/phase-d-proof-ledger.json
!/artifacts/client-authority-document-manifest.json
!/artifacts/client-clarification-register.json
!/artifacts/phase-a-findings.json
!/artifacts/phase-a-legal-document-conflict-register.json

# local audit scratch files
route_report.json
components_report.json
discovery_files.txt
gen_report.js

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.claude

# generated Playwright output
/output/
