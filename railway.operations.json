{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "dockerfilePath": "Dockerfile.operations" },
  "deploy": {
    "startCommand": "sh -lc 'node node_modules/tsx/dist/cli.mjs scripts/audit-reviewed-production.ts && exec node node_modules/tsx/dist/cli.mjs scripts/production-processors.ts'",
    "preDeployCommand": "node scripts/validate-isolated-production-processors.mjs",
    "preDeployTimeoutSeconds": 1800,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
