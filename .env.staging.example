# ==============================================================================
# KT Couriers — Staging Demo Environment Configuration Template
# Copy this file to .env.staging or .env.local on your staging demonstration host.
# ==============================================================================

# 1. Database Connection (Isolated Staging Database)
DATABASE_URL="postgresql://kt_courier_user:kt_courier_password@localhost:5433/kt_courier_staging?schema=public"
SHADOW_DATABASE_URL="postgresql://kt_courier_user:kt_courier_password@localhost:5433/kt_courier_staging_shadow?schema=public"

# 2. Host Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Demo Universe & Media Gates
# Setting KT_STAGING_DEMO_ENABLED="true" enables the staging media delivery adapter
# and permits execution of demo seeders and connectivity verifiers.
KT_STAGING_DEMO_ENABLED="true"
CATALOG_MEDIA_STORAGE="filesystem"
CATALOG_MEDIA_LOCAL_DIR="var/catalog-media"
REPORT_ARTIFACT_STORAGE="local"
REPORT_ARTIFACT_DIR="artifacts/reports"
PRIVATE_MEDIA_STORAGE="local"
PRIVATE_MEDIA_LOCAL_DIR="var/private-media"

# 4. Standard Demo Password
# Sets the password applied to all demonstration personas (Admins, Store Owners, Drivers, Customers, Promoters).
KT_DEMO_ACCOUNT_PASSWORD="password123"

# 5. Reverse Proxy & Network Model
TRUSTED_PROXY_MODE="direct"

# 6. Payment Gateway Sandbox / Test Mode
# Payments run in simulated sandbox mode during demonstration flows.
PAYSTACK_MODE="disabled"
PAYSTACK_SECRET_KEY="sk_test_staging_placeholder"
PAYSTACK_PUBLIC_KEY="pk_test_staging_placeholder"

PAYFAST_MODE="disabled"
PAYFAST_MERCHANT_ID="10000100"
PAYFAST_MERCHANT_KEY="46f0cd694581a"
PAYFAST_PASSPHRASE="ktcourier_staging_demo"
PAYFAST_CREDENTIAL_VERSION="staging-v1"
PAYMENT_PROXY_MODE="direct"
PAYMENT_APP_ORIGIN="http://localhost:3000"

# 7. Communications (Console Provider for Staging)
EMAIL_PROVIDER="console"
EMAIL_FROM="KT Couriers Staging <noreply@ktcourier.co.za>"
EMAIL_REPLY_TO="support@ktcourier.co.za"

# 8. Maps & Geo Services (Staging Keys)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="AIzaSyStagingBrowserKeyPlaceholder"
GOOGLE_MAPS_SERVER_KEY="AIzaSyStagingServerKeyPlaceholder"

# 9. Developer API & System Secrets
DEVELOPER_API_CREDENTIAL_HMAC_KEY="staging_credential_hmac_secret_key_at_least_32_chars!"
DEVELOPER_API_CURSOR_HMAC_KEY="staging_cursor_hmac_secret_key_at_least_32_chars!"
DEVELOPER_WEBHOOK_ENCRYPTION_KEY="MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY="
DEVELOPER_API_ENDPOINT_ENVIRONMENT="TEST"
CRON_SECRET="staging_cron_secret_key_at_least_32_characters!"
INTERNAL_JOB_SECRET="staging_internal_job_secret_key_at_least_32_chars!"

# 10. Commercial Invariants & Payout Locks
# In staging demo mode, real external payouts remain locked (fail-closed).
CHECKOUT_PUBLIC_ENABLED="true"
WITHDRAWAL_PAYOUT_ENABLED="false"
