# ==============================================================================
# KT Couriers — Staging Demonstration Environment Configuration Template
# Copy this file to .env.staging or .env.local on your staging demonstration host.
# INVARIANT: All secrets and keys must be injected by deployment orchestration.
# No usable credentials or passwords are committed in this repository.
# ==============================================================================

# 1. Deployment & Runtime Classification (Canonical Staging Conjunction)
NODE_ENV="production"
KT_RUNTIME_ENV="staging-demo"
KT_DATABASE_CLASSIFICATION="staging"
KT_STAGING_DEMO_ENABLED="true"

# 2. Database Connection (Dedicated Staging Demonstration Target)
# NOTE: Primary/reserved database names (kt_courier_staging, kt_courier_production)
# are protected against seeding. A dedicated database name such as kt_courier_staging_demo
# is required for demo:seed:staging. Destructive schema drops remain strictly forbidden.
DATABASE_URL="postgresql://<staging_db_user>:<staging_db_password>@<staging_db_host>:5432/kt_courier_staging_demo?schema=public"
SHADOW_DATABASE_URL="postgresql://<staging_db_user>:<staging_db_password>@<staging_db_host>:5432/kt_courier_staging_demo_shadow?schema=public"

# 3. Host Application URL & Origins
NEXT_PUBLIC_APP_URL="https://staging.ktcourier.co.za"
PAYMENT_APP_ORIGIN="https://staging.ktcourier.co.za"

# 4. Catalog Media & Artifact Storage Gates
# In staging-demo runtime, the local filesystem catalog media adapter is permitted.
CATALOG_MEDIA_STORAGE="filesystem"
CATALOG_MEDIA_LOCAL_DIR="var/catalog-media"
REPORT_ARTIFACT_STORAGE="local"
REPORT_ARTIFACT_DIR="artifacts/reports"
PRIVATE_MEDIA_STORAGE="local"
PRIVATE_MEDIA_LOCAL_DIR="var/private-media"

# 5. Shared Demonstration Account Password
# Must be supplied from deployment secret configuration. No fallback password is committed.
KT_DEMO_ACCOUNT_PASSWORD="<injected-staging-demo-account-password-do-not-commit>"

# 6. Reverse Proxy & Network Model
TRUSTED_PROXY_MODE="direct"

# 7. Payment Gateway Configuration (Paystack Sandbox / Test Mode ONLY)
# INVARIANT: In staging-demo, only PAYSTACK_MODE=test with sk_test_* keys is allowed.
# Live money transactions and external payouts remain strictly locked.
PAYSTACK_MODE="test"
PAYSTACK_SECRET_KEY="<injected-paystack-sandbox-secret-sk_test_...-do-not-commit>"
PAYSTACK_PUBLIC_KEY="<injected-paystack-sandbox-public-pk_test_...-do-not-commit>"
PAYSTACK_CREDENTIAL_VERSION="staging-demo-v1"

# Legacy provider kept disabled
PAYFAST_MODE="disabled"
PAYFAST_MERCHANT_ID="<injected-payfast-sandbox-merchant-id>"
PAYFAST_MERCHANT_KEY="<injected-payfast-sandbox-merchant-key>"
PAYFAST_PASSPHRASE="<injected-payfast-sandbox-passphrase>"
PAYFAST_CREDENTIAL_VERSION="staging-demo-v1"
PAYMENT_PROXY_MODE="direct"

# 8. Communications (Console / In-Memory Provider for Staging)
EMAIL_PROVIDER="console"
EMAIL_FROM="KT Couriers Staging <noreply@ktcourier.co.za>"
EMAIL_REPLY_TO="support@ktcourier.co.za"

# 9. Maps & Geo Services (Staging Keys)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY="<injected-google-maps-browser-key>"
GOOGLE_MAPS_SERVER_KEY="<injected-google-maps-server-key>"

# 10. Developer API & System Secrets (Minimum 32 Characters)
DEVELOPER_API_CREDENTIAL_HMAC_KEY="<injected-developer-api-hmac-key-min-32-chars-do-not-commit>"
DEVELOPER_API_CURSOR_HMAC_KEY="<injected-developer-cursor-hmac-key-min-32-chars-do-not-commit>"
DEVELOPER_WEBHOOK_ENCRYPTION_KEY="<injected-developer-webhook-key-base64-do-not-commit>"
DEVELOPER_API_ENDPOINT_ENVIRONMENT="TEST"
CRON_SECRET="<injected-cron-secret-min-32-chars-do-not-commit>"
INTERNAL_JOB_SECRET="<injected-internal-job-secret-min-32-chars-do-not-commit>"

# 11. Commercial Invariants & Payout Locks
# Staging client demo exposes checkout in Paystack test mode; live money payouts remain locked.
CHECKOUT_PUBLIC_ENABLED="true"
WITHDRAWAL_PAYOUT_ENABLED="false"
