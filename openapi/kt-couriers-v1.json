    "responses": { "Problem": { "description": "RFC 9457-style Problem Details", "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } } }, "Resource": { "description": "Privacy-safe resource DTO", "headers": { "X-Request-Id": { "schema": { "type": "string" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Resource" } } } }, "List": { "description": "Bounded privacy-safe list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/List" } } } }, "Page": { "description": "Owner-bound cursor page", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CursorPage" } } } }, "Metadata": { "description": "API metadata", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Metadata" } } } }, "OneTimeSecret": { "description": "Response may contain a signing secret exactly once; no replay response includes it.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Resource" } } } } },
    "schemas": { "PublicReference": { "type": "string", "minLength": 8, "maxLength": 180, "pattern": "^(?:KT-\\d{4}-[A-Z0-9]+|[a-z][a-z0-9]*_[A-Za-z0-9_-]{6,})$" }, "Problem": { "type": "object", "additionalProperties": false, "required": ["type", "title", "status", "detail", "instance", "code", "requestId"], "properties": { "type": { "type": "string", "format": "uri" }, "title": { "type": "string" }, "status": { "type": "integer" }, "detail": { "type": "string" }, "instance": { "type": "string" }, "code": { "type": "string" }, "requestId": { "type": "string" }, "retryAfter": { "type": "integer", "minimum": 1 }, "errors": { "type": "object", "additionalProperties": { "type": "string" } } } }, "Metadata": { "type": "object", "additionalProperties": false, "required": ["name", "version", "documentation"], "properties": { "name": { "type": "string" }, "version": { "const": "v1" }, "documentation": { "type": "string" } } }, "Resource": { "type": "object", "additionalProperties": true, "description": "Every runtime resource mapper is privacy-safe and only emits public references, public state, safe timestamps, and allowed fields." }, "List": { "type": "object", "additionalProperties": false, "required": ["data"], "properties": { "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/Resource" } } } }, "CursorPage": { "type": "object", "additionalProperties": false, "required": ["data", "page"], "properties": { "data": { "type": "array", "maxItems": 100, "items": { "$ref": "#/components/schemas/Resource" } }, "page": { "type": "object", "additionalProperties": false, "required": ["nextCursor", "hasMore", "limit"], "properties": { "nextCursor": { "type": ["string", "null"] }, "hasMore": { "type": "boolean" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 } } } } }, "QuoteRequest": { "type": "object", "additionalProperties": false }, "OrderRequest": { "type": "object", "additionalProperties": false }, "OrderCancelRequest": { "type": "object", "additionalProperties": false }, "StoreOrderAcceptRequest": { "type": "object", "additionalProperties": false, "required": ["preparationMinutes", "pickupInstructions"], "properties": { "preparationMinutes": { "type": "integer", "minimum": 1, "maximum": 720 }, "pickupInstructions": { "type": "string", "minLength": 1, "maxLength": 500 } } }, "StoreOrderRejectRequest": { "type": "object", "additionalProperties": false, "required": ["reasonCode"], "properties": { "reasonCode": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Z0-9_]+$" }, "note": { "type": "string", "minLength": 1, "maxLength": 500 } } }, "StoreOrderReadyRequest": { "type": "object", "additionalProperties": false, "properties": { "packageEvidence": { "type": "object", "additionalProperties": false, "properties": { "packageCount": { "type": "integer", "minimum": 1, "maximum": 100 }, "sealed": { "type": "boolean" } } } } }, "WebhookCreateRequest": { "type": "object", "additionalProperties": false, "required": ["endpoint", "eventTypes"], "properties": { "endpoint": { "type": "string", "format": "uri", "maxLength": 2048 }, "eventTypes": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string" } } } }, "WebhookPatchRequest": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "endpoint": { "type": "string", "format": "uri", "maxLength": 2048 }, "eventTypes": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string" } } } }, "WebhookEnvelope": { "type": "object", "additionalProperties": false, "required": ["specversion", "id", "source", "type", "time", "subject", "datacontenttype", "dataschema", "data"], "properties": { "specversion": { "const": "1.0" }, "id": { "type": "string" }, "source": { "type": "string", "format": "uri" }, "type": { "type": "string" }, "time": { "type": "string", "format": "date-time" }, "subject": { "type": "string" }, "datacontenttype": { "const": "application/json" }, "dataschema": { "type": "string" }, "data": { "type": "object" } } } }
